package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListGetTest {
    
    private LinkedList linkedList;
    
    @BeforeEach
    public void setUp() {
        linkedList = new LinkedList();
    }
    
    @Test
    @Tag("valid")
    public void getElementAtFirstIndex() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        // Act
        String result = linkedList.get(0);
        
        // Assert
        assertEquals("first", result);
    }
    
    @Test
    @Tag("valid")
    public void getElementAtMiddleIndex() {
        // Arrange
        linkedList.add("apple");
        linkedList.add("banana");
        linkedList.add("cherry");
        linkedList.add("date");
        
        // Act
        String result = linkedList.get(2);
        
        // Assert
        assertEquals("cherry", result);
    }
    
    @Test
    @Tag("boundary")
    public void getElementAtLastIndex() {
        // Arrange
        linkedList.add("start");
        linkedList.add("middle");
        linkedList.add("end");
        
        // Act
        String result = linkedList.get(2);
        
        // Assert
        assertEquals("end", result);
    }
    
    @Test
    @Tag("boundary")
    public void getElementFromEmptyList() {
        // Arrange
        // LinkedList is already empty from setUp()
        
        // Act & Assert
        IndexOutOfBoundsException exception = assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(0);
        });
        assertEquals("Index is out of range", exception.getMessage());
    }
    
    @Test
    @Tag("invalid")
    public void getElementWithNegativeIndex() {
        // Arrange
        linkedList.add("item1");
        linkedList.add("item2");
        linkedList.add("item3");
        
        // Act & Assert
        IndexOutOfBoundsException exception = assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-1);
        });
        assertEquals("Index is out of range", exception.getMessage());
    }
    
    @Test
    @Tag("invalid")
    public void getElementWithIndexExceedingSize() {
        // Arrange
        linkedList.add("alpha");
        linkedList.add("beta");
        
        // Act & Assert
        IndexOutOfBoundsException exception = assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(5);
        });
        assertEquals("Index is out of range", exception.getMessage());
    }
    
    @Test
    @Tag("boundary")
    public void getElementFromSingleElementList() {
        // Arrange
        linkedList.add("solo");
        
        // Act
        String result = linkedList.get(0);
        
        // Assert
        assertEquals("solo", result);
    }
    
    @Test
    @Tag("valid")
    public void getElementWithLargeValidIndex() {
        // Arrange
        linkedList.add("elem0");
        linkedList.add("elem1");
        linkedList.add("elem2");
        linkedList.add("elem3");
        linkedList.add("elem4");
        linkedList.add("elem5");
        
        // Act
        String result = linkedList.get(4);
        
        // Assert
        assertEquals("elem4", result);
    }
    
    @Test
    @Tag("invalid")
    public void getElementWithIndexJustBeyondSize() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        
        // Act & Assert
        IndexOutOfBoundsException exception = assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(2);
        });
        assertEquals("Index is out of range", exception.getMessage());
    }
    
    @Test
    @Tag("boundary")
    public void getElementWithZeroIndexOnSingleElement() {
        // Arrange
        linkedList.add("onlyElement");
        
        // Act
        String result = linkedList.get(0);
        
        // Assert
        assertEquals("onlyElement", result);
        assertNotNull(result);
    }
    
    @Test
    @Tag("valid")
    public void getElementWithSequentialAccess() {
        // Arrange
        linkedList.add("zero");
        linkedList.add("one");
        linkedList.add("two");
        linkedList.add("three");
        
        // Act & Assert
        assertEquals("zero", linkedList.get(0));
        assertEquals("one", linkedList.get(1));
        assertEquals("two", linkedList.get(2));
        assertEquals("three", linkedList.get(3));
    }
    
    @Test
    @Tag("invalid")
    public void getElementWithLargeNegativeIndex() {
        // Arrange
        linkedList.add("test1");
        linkedList.add("test2");
        
        // Act & Assert
        IndexOutOfBoundsException exception = assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-100);
        });
        assertEquals("Index is out of range", exception.getMessage());
    }
}