package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListRemoveTest {
    
    private LinkedList linkedList;
    
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    
    @Test
    @Tag("boundary")
    void removeFromEmptyList() {
        // Arrange - LinkedList is already empty from setUp
        
        // Act
        boolean result = linkedList.remove("anyElement");
        
        // Assert
        assertFalse(result);
        assertEquals(0, linkedList.size());
    }
    
    @Test
    @Tag("boundary")
    void removeSingleElementFromSingleElementList() {
        // Arrange
        linkedList.add("onlyElement");
        
        // Act
        boolean result = linkedList.remove("onlyElement");
        
        // Assert
        assertTrue(result);
        assertEquals(0, linkedList.size());
    }
    
    @Test
    @Tag("valid")
    void removeFirstElementFromMultipleElementList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        // Act
        boolean result = linkedList.remove("first");
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("second", linkedList.get(0));
    }
    
    @Test
    @Tag("valid")
    void removeMiddleElementFromMultipleElementList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("middle");
        linkedList.add("last");
        
        // Act
        boolean result = linkedList.remove("middle");
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("last", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void removeLastElementFromMultipleElementList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("last");
        
        // Act
        boolean result = linkedList.remove("last");
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("second", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void removeNonExistentElementFromPopulatedList() {
        // Arrange
        linkedList.add("alpha");
        linkedList.add("beta");
        linkedList.add("gamma");
        int originalSize = linkedList.size();
        
        // Act
        boolean result = linkedList.remove("delta");
        
        // Assert
        assertFalse(result);
        assertEquals(originalSize, linkedList.size());
        assertEquals("alpha", linkedList.get(0));
        assertEquals("beta", linkedList.get(1));
        assertEquals("gamma", linkedList.get(2));
    }
    
    @Test
    @Tag("invalid")
    void removeWithNullParameter() {
        // Arrange
        linkedList.add("element1");
        linkedList.add("element2");
        
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            linkedList.remove(null);
        });
    }
    
    @Test
    @Tag("valid")
    void removeDuplicateElements() {
        // Arrange
        linkedList.add("item");
        linkedList.add("other");
        linkedList.add("item");
        linkedList.add("another");
        
        // Act
        boolean result = linkedList.remove("item");
        
        // Assert
        assertTrue(result);
        assertEquals(3, linkedList.size());
        assertEquals("other", linkedList.get(0));
        assertEquals("item", linkedList.get(1));
        assertEquals("another", linkedList.get(2));
    }
    
    @Test
    @Tag("integration")
    void removeElementsInSequentialOrder() {
        // Arrange
        linkedList.add("one");
        linkedList.add("two");
        linkedList.add("three");
        linkedList.add("four");
        
        // Act & Assert
        assertTrue(linkedList.remove("one"));
        assertEquals(3, linkedList.size());
        
        assertTrue(linkedList.remove("two"));
        assertEquals(2, linkedList.size());
        
        assertTrue(linkedList.remove("three"));
        assertEquals(1, linkedList.size());
        
        assertTrue(linkedList.remove("four"));
        assertEquals(0, linkedList.size());
    }
    
    @Test
    @Tag("valid")
    void removeCaseSensitiveElements() {
        // Arrange
        linkedList.add("Test");
        linkedList.add("test");
        linkedList.add("TEST");
        
        // Act
        boolean result = linkedList.remove("Test");
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("test", linkedList.get(0));
        assertEquals("TEST", linkedList.get(1));
    }
}