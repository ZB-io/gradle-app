package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListAddTest {
    
    private LinkedList linkedList;
    
    /**
     * Sets up a fresh LinkedList instance before each test method execution
     */
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    
    /**
     * Tests adding a single element to an empty linked list
     * Verifies that the size becomes 1 and the element is retrievable at index 0
     */
    @Test
    @Tag("valid")
    void addElementToEmptyList() {
        linkedList.add("first");
        
        assertEquals(1, linkedList.size());
        assertEquals("first", linkedList.get(0));
    }
    
    /**
     * Tests adding multiple elements sequentially to the linked list
     * Verifies that all elements are added in the correct order and size is updated properly
     */
    @Test
    @Tag("valid")
    void addMultipleElementsSequentially() {
        linkedList.add("alpha");
        
        linkedList.add("beta");
        linkedList.add("gamma");
        linkedList.add("delta");
        
        assertEquals(4, linkedList.size());
        assertEquals("alpha", linkedList.get(0));
        assertEquals("beta", linkedList.get(1));
        assertEquals("gamma", linkedList.get(2));
        assertEquals("delta", linkedList.get(3));
    }
    
    /**
     * Tests adding a null element to the linked list
     * Verifies that null values can be stored and retrieved correctly
     */
    @Test
    @Tag("boundary")
    void addNullElement() {
        linkedList.add(null);
        
        assertEquals(1, linkedList.size());
        assertNull(linkedList.get(0));
    }
    
    /**
     * Tests adding an empty string element to the linked list
     * Verifies that empty strings are handled correctly as valid elements
     */
    @Test
    @Tag("boundary")
    void addEmptyStringElement() {
        linkedList.add("");
        
        assertEquals(1, linkedList.size());
        assertEquals("", linkedList.get(0));
    }
    
    /**
     * Tests adding an element after performing a removal operation
     * Verifies that the list maintains correct order and size after modification
     */
    @Test
    @Tag("integration")
    void addElementAfterRemoval() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        linkedList.remove("second");
        
        linkedList.add("fourth");
        
        assertEquals(3, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
        assertEquals("fourth", linkedList.get(2));
    }
    
    /**
     * Tests adding duplicate elements to the linked list
     * Verifies that duplicate values are allowed and stored separately
     */
    @Test
    @Tag("valid")
    void addDuplicateElements() {
        linkedList.add("duplicate");
        linkedList.add("duplicate");
        linkedList.add("duplicate");
        
        assertEquals(3, linkedList.size());
        assertEquals("duplicate", linkedList.get(0));
        assertEquals("duplicate", linkedList.get(1));
        assertEquals("duplicate", linkedList.get(2));
    }
    
    /**
     * Tests adding elements containing special characters
     * Verifies that strings with special symbols and unicode characters are handled correctly
     */
    @Test
    @Tag("valid")
    void addElementWithSpecialCharacters() {
        linkedList.add("hello@world");
        linkedList.add("test#123");
        linkedList.add("unicode→text");
        
        assertEquals(3, linkedList.size());
        assertEquals("hello@world", linkedList.get(0));
        assertEquals("test#123", linkedList.get(1));
        assertEquals("unicode→text", linkedList.get(2));
    }
    
    /**
     * Tests adding a very long string element to the linked list
     * Verifies that large strings (1000 characters) are handled correctly
     */
    @Test
    @Tag("boundary")
    void addVeryLongStringElement() {
        StringBuilder longString = new StringBuilder();
        for (int i = 0; i < 1000; i++) {
            longString.append("a");
        }
        String veryLongString = longString.toString();
        
        linkedList.add(veryLongString);
        
        assertEquals(1, linkedList.size());
        assertEquals(veryLongString, linkedList.get(0));
        assertEquals(1000, linkedList.get(0).length());
    }
    
    /**
     * Tests adding numeric string elements to the linked list
     * Verifies that numeric strings including decimals and negative numbers are handled correctly
     */
    @Test
    @Tag("valid")
    void addNumericStringElements() {
        linkedList.add("123");
        linkedList.add("456.78");
        linkedList.add("-999");
        
        assertEquals(3, linkedList.size());
        assertEquals("123", linkedList.get(0));
        assertEquals("456.78", linkedList.get(1));
        assertEquals("-999", linkedList.get(2));
    }
    
    /**
     * Tests adding elements that contain only whitespace characters
     * Verifies that various whitespace characters are preserved as valid elements
     */
    @Test
    @Tag("boundary")
    void addWhitespaceOnlyElements() {
        linkedList.add(" ");
        linkedList.add("\t");
        linkedList.add("\n");
        linkedList.add("   ");
        
        assertEquals(4, linkedList.size());
        assertEquals(" ", linkedList.get(0));
        assertEquals("\t", linkedList.get(1));
        assertEquals("\n", linkedList.get(2));
        assertEquals("   ", linkedList.get(3));
    }
    
    /**
     * Tests adding a mixture of null and valid string elements
     * Verifies that null and non-null elements can coexist in the list
     */
    @Test
    @Tag("valid")
    void addMixedNullAndValidElements() {
        linkedList.add("first");
        linkedList.add(null);
        linkedList.add("third");
        linkedList.add(null);
        
        assertEquals(4, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertNull(linkedList.get(1));
        assertEquals("third", linkedList.get(2));
        assertNull(linkedList.get(3));
    }
    
    /**
     * Tests adding a large number of elements to verify performance and capacity
     * Verifies that the list can handle 100 elements correctly
     */
    @Test
    @Tag("performance")
    void addLargeNumberOfElements() {
        for (int i = 0; i < 100; i++) {
            linkedList.add("element" + i);
        }
        
        assertEquals(100, linkedList.size());
        assertEquals("element0", linkedList.get(0));
        assertEquals("element50", linkedList.get(50));
        assertEquals("element99", linkedList.get(99));
    }
    
    /**
     * Tests adding elements with leading and trailing spaces
     * Verifies that whitespace at the beginning and end of strings is preserved
     */
    @Test
    @Tag("boundary")
    void addElementsWithLeadingTrailingSpaces() {
        linkedList.add(" leading");
        linkedList.add("trailing ");
        linkedList.add(" both ");
        
        assertEquals(3, linkedList.size());
        assertEquals(" leading", linkedList.get(0));
        assertEquals("trailing ", linkedList.get(1));
        assertEquals(" both ", linkedList.get(2));
    }
    
    /**
     * Tests adding an element after clearing the entire list
     * Verifies that the list functions correctly after a clear operation
     */
    @Test
    @Tag("integration")
    void addElementAfterClearOperation() {
        linkedList.add("temp1");
        linkedList.add("temp2");
        linkedList.clear();
        
        linkedList.add("newElement");
        
        assertEquals(1, linkedList.size());
        assertEquals("newElement", linkedList.get(0));
    }
    
    /**
     * Tests adding elements containing Unicode characters including emojis
     * Verifies that international characters and emojis are handled correctly
     */
    @Test
    @Tag("valid")
    void addElementsWithUnicodeCharacters() {
        linkedList.add("café");
        linkedList.add("naïve");
        linkedList.add("résumé");
        linkedList.add("🚀");
        
        assertEquals(4, linkedList.size());
        assertEquals("café", linkedList.get(0));
        assertEquals("naïve", linkedList.get(1));
        assertEquals("résumé", linkedList.get(2));
        assertEquals("🚀", linkedList.get(3));
    }
}
