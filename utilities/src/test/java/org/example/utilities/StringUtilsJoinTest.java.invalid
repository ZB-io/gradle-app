package org.example.utilities;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.MethodSource;
import org.mockito.MockedStatic;
import org.mockito.Mockito;
import org.example.list.LinkedList;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import java.util.stream.Stream;
import org.junit.jupiter.api.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    void joinValidLinkedListWithMultipleElements() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("apple");
        source.add("banana");
        source.add("cherry");
        String expectedResult = "apple,banana,cherry";
        
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            
            // Act
            String result = StringUtils.join(source);
            
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source));
        }
    }
    @Test
    @Tag("boundary")
    void joinEmptyLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        String expectedResult = "";
        
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            
            // Act
            String result = StringUtils.join(source);
            
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source));
        }
    }
    @Test
    @Tag("boundary")
    void joinLinkedListWithSingleElement() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("singleItem");
        String expectedResult = "singleItem";
        
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            
            // Act
            String result = StringUtils.join(source);
            
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source));
        }
    }
    @Test
    @Tag("invalid")
    void joinNullLinkedList() {
        // Arrange
        LinkedList source = null;
        
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(null)).thenThrow(new IllegalArgumentException("Source cannot be null"));
            
            // Act & Assert
            assertThrows(IllegalArgumentException.class, () -> StringUtils.join(source));
            mockedJoinUtils.verify(() -> JoinUtils.join(null));
        }
    }
