    @ParameterizedTest
    @MethodSource("provideDelegationTestCases")
    @Tag("integration")
    void joinDelegationTest(LinkedList input, String expectedOutput, boolean shouldThrow) {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            if (shouldThrow) {
                mockedJoinUtils.when(() -> JoinUtils.join(input))
                    .thenThrow(new RuntimeException("JoinUtils error"));
                
                assertThrows(RuntimeException.class, () -> StringUtils.join(input));
            } else {
                mockedJoinUtils.when(() -> JoinUtils.join(input)).thenReturn(expectedOutput);
                
                String result = StringUtils.join(input);
                
                assertEquals(expectedOutput, result);
            }
            
            mockedJoinUtils.verify(() -> JoinUtils.join(input));
        }
    }
    static Stream<Object[]> provideDelegationTestCases() {
        LinkedList multipleElements = new LinkedList();
        multipleElements.add("a");
        multipleElements.add("b");
        multipleElements.add("c");
        
        LinkedList singleElement = new LinkedList();
        singleElement.add("single");
        
        LinkedList emptyList = new LinkedList();
        
        LinkedList withNulls = new LinkedList();
        withNulls.add("valid");
        withNulls.add(null);
        
        return Stream.of(
            new Object[]{multipleElements, "a,b,c", false},
            new Object[]{singleElement, "single", false},
            new Object[]{emptyList, "", false},
            new Object[]{withNulls, "valid,null", false},
            new Object[]{null, null, true}
        );
    }
    @Test
    @Tag("integration")
    void joinMethodDelegatesCorrectly() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("test1");
        source.add("test2");
        
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
