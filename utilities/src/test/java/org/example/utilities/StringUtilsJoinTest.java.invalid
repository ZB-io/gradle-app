package org.example.utilities;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.BeforeEach;
import org.mockito.MockedStatic;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.example.list.LinkedList;
import org.junit.jupiter.api.*;

public class StringUtilsJoinTest {
    private LinkedList mockLinkedList;
    @BeforeEach
    void setUp() {
        mockLinkedList = mock(LinkedList.class);
    }
    @Test
    @Tag("valid")
    void joinWithValidNonEmptyLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("apple");
        source.add("banana");
        source.add("cherry");
        String expectedResult = "apple,banana,cherry";
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            // Act
            String result = StringUtils.join(source);
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source), times(1));
        }
    }
    @Test
    @Tag("boundary")
    void joinWithEmptyLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        String expectedResult = "";
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            // Act
            String result = StringUtils.join(source);
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source), times(1));
        }
    }
    @Test
    @Tag("boundary")
    void joinWithSingleElementLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("single");
        String expectedResult = "single";
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            // Act
            String result = StringUtils.join(source);
            // Assert
            assertEquals(expectedResult, result);
            mockedJoinUtils.verify(() -> JoinUtils.join(source), times(1));
        }
    }
    @Test
    @Tag("invalid")
    void joinWithNullLinkedList() {
        // Arrange
        LinkedList source = null;
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(null)).thenThrow(new IllegalArgumentException("Source cannot be null"));
            // Act & Assert
            assertThrows(IllegalArgumentException.class, () -> StringUtils.join(source));
            mockedJoinUtils.verify(() -> JoinUtils.join(null), times(1));
        }
    }
    @Test
    @Tag("boundary")
    void joinWithLinkedListContainingNullElements() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("first");
        source.add(null);
        source.add("third");
        String expectedResult = "first,null,third";
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
            // Act
