    @Test
    @Tag("valid")
    void joinWithLinkedListContainingSpecialCharacters() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("hello@world");
        source.add("test#123");
        source.add("special$chars");
        String expectedResult = "hello@world,test#123,special$chars";
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expectedResult);
