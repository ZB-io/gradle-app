            mockedJoinUtils.when(() -> JoinUtils.join(null)).thenThrow(new NullPointerException());
            assertThrows(NullPointerException.class, () -> StringUtils.join(null));
        }
    }
    @Test
    @Tag("valid")
    void joinWithListContainingNullElements() {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            LinkedList<Object> source = new LinkedList<>();
            source.add("A");
            source.add(null);
            source.add("B");
            String expected = "AnullB";
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expected);
            String actual = StringUtils.join(source);
            assertEquals(expected, actual);
        }
    }
    @Test
    @Tag("valid")
    void joinWithListContainingEmptyStrings() {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            LinkedList<String> source = new LinkedList<>();
            source.add("first");
            source.add("");
            source.add("last");
            String expected = "firstlast";
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expected);
