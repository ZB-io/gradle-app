package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.MockedStatic;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    void joinWithMultipleStringElements() {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            LinkedList<String> source = new LinkedList<>();
            source.add("Hello");
            source.add(" ");
            source.add("World");
            String expected = "Hello World";
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expected);
            String actual = StringUtils.join(source);
            assertEquals(expected, actual);
        }
    }
    @Test
    @Tag("boundary")
    void joinWithEmptyList() {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            LinkedList<String> source = new LinkedList<>();
            String expected = "";
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expected);
            String actual = StringUtils.join(source);
            assertEquals(expected, actual);
        }
    }
    @Test
    @Tag("boundary")
    void joinWithSingleElementList() {
        try (MockedStatic<JoinUtils> mockedJoinUtils = Mockito.mockStatic(JoinUtils.class)) {
            LinkedList<String> source = new LinkedList<>();
            source.add("Test");
            String expected = "Test";
            mockedJoinUtils.when(() -> JoinUtils.join(source)).thenReturn(expected);
            String actual = StringUtils.join(source);
            assertEquals(expected, actual);
        }
    }
