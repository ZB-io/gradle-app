package org.example.utilities;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.example.list.LinkedList;
import static org.junit.jupiter.api.Assertions.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    @DisplayName("Split Valid String with Multiple Words")
    void splitValidStringWithMultipleWords() {
        // Act
        LinkedList result = StringUtils.split("hello world java");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Split Empty String")
    void splitEmptyString() {
        // Act
        LinkedList result = StringUtils.split("");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("invalid")
    @DisplayName("Split Null String Input")
    void splitNullStringInput() {
        // Act & Assert
        assertDoesNotThrow(() -> StringUtils.split(null));
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Split Single Word String")
    void splitSingleWordString() {
        // Act
        LinkedList result = StringUtils.split("hello");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Split String with Only Delimiters")
    void splitStringWithOnlyDelimiters() {
        // Act
        LinkedList result = StringUtils.split("   ");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Split String with Leading and Trailing Delimiters")
    void splitStringWithLeadingAndTrailingDelimiters() {
        // Act
        LinkedList result = StringUtils.split(" hello world ");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Split String with Consecutive Delimiters")
    void splitStringWithConsecutiveDelimiters() {
        // Act
        LinkedList result = StringUtils.split("hello   world");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Split Very Long String")
    void splitVeryLongString() {
        // Arrange
        StringBuilder longStringBuilder = new StringBuilder();
        for (int i = 0; i < 1000; i++) {
            longStringBuilder.append("word").append(i).append(" ");
        }
        String veryLongString = longStringBuilder.toString().trim();
        
        // Act
        LinkedList result = StringUtils.split(veryLongString);
        
        // Assert
        assertNotNull(result);
    }
    
    @ParameterizedTest
    @Tag("valid")
    @ValueSource(strings = {"one two three", "apple,banana,cherry", "a-b-c-d", "test\tdata\nhere"})
    @DisplayName("Split Various Valid String Formats")
    void splitVariousValidStringFormats(String input) {
        // Act
        LinkedList result = StringUtils.split(input);
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("integration")
    @DisplayName("Split Method Integration Test")
    void splitMethodIntegrationTest() {
        // Act
        LinkedList result = StringUtils.split("integration test data");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Split String with Special Characters")
    void splitStringWithSpecialCharacters() {
        // Act
        LinkedList result = StringUtils.split("hello@world#java$programming");
        
        // Assert
        assertNotNull(result);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Split String with Unicode Characters")
    void splitStringWithUnicodeCharacters() {
        // Act
        LinkedList result = StringUtils.split("こんにちは 世界 プログラミング");
        
        // Assert
        assertNotNull(result);
    }
