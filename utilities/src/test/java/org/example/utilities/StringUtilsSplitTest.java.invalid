package org.example.utilities;
import org.example.StringUtils;
import org.example.list.LinkedList;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;
import org.junit.jupiter.api.*;

public class StringUtilsSplitTest {
    private LinkedList createExpectedList(String... elements) {
        LinkedList list = new LinkedList();
        for (String element : elements) {
            list.add(element);
        }
        return list;
    }
    @Test
    @Tag("valid")
    @DisplayName("This test verifies that the \"split\" method correctly tokenizes a string containing multiple words separated by single spaces into a LinkedList of those words.")
    public void splitShouldReturnListOfWordsForStandardString() {
        // Arrange
        String source = "Hello World Java";
        LinkedList expected = createExpectedList("Hello", "World", "Java");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    @DisplayName("This test ensures that the \"split\" method treats multiple consecutive spaces between words as a single delimiter and does not produce empty strings in the output list.")
    public void splitShouldHandleMultipleSpacesBetweenWords() {
        // Arrange
        String source = "Multiple   spaces  here";
        LinkedList expected = createExpectedList("Multiple", "spaces", "here");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    @DisplayName("This test checks if the \"split\" method correctly ignores any whitespace at the beginning and end of the input string.")
    public void splitShouldTrimLeadingAndTrailingWhitespace() {
        // Arrange
        String source = "  some words  ";
        LinkedList expected = createExpectedList("some", "words");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    @DisplayName("This test verifies that providing an empty string to the \"split\" method results in an empty LinkedList.")
    public void splitShouldReturnEmptyListForEmptyString() {
        // Arrange
        String source = "";
        LinkedList expected = new LinkedList();
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
        assertTrue(actual.isEmpty());
    }
    @Test
    @Tag("boundary")
    @DisplayName("This test ensures that if the input string consists solely of whitespace characters (spaces, tabs, newlines), the \"split\" method returns an empty LinkedList.")
    public void splitShouldReturnEmptyListForWhitespaceOnlyString() {
        // Arrange
        String source = "   \t  \n ";
        LinkedList expected = new LinkedList();
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
        assertTrue(actual.isEmpty());
    }
    @Test
    @Tag("valid")
    @DisplayName("This test checks that a string containing a single word (with no whitespace) is correctly converted into a LinkedList with that single word as its only element.")
    public void splitShouldReturnListWithOneElementForSingleWordString() {
        // Arrange
        String source = "OneWord";
        LinkedList expected = createExpectedList("OneWord");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("invalid")
    @DisplayName("This test verifies that the \"split\" method handles a null input appropriately, which typically means throwing a \"NullPointerException\" or another suitable exception, as the underlying utility is expected to fail.")
    public void splitShouldThrowExceptionForNullInput() {
        // Arrange
        String source = null;
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            StringUtils.split(source);
        });
    }
    @Test
    @Tag("valid")
    @DisplayName("This test ensures the \"split\" method can handle a string where words are separated by a mix of different whitespace characters, such as spaces, tabs (\"\t\"), and newlines (\"\n\").")
    public void splitShouldHandleMixedWhitespaceDelimiters() {
        // Arrange
        String source = "word1\tword2\nword3";
        LinkedList expected = createExpectedList("word1", "word2", "word3");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    @DisplayName("This test verifies that the \"split\" method correctly splits a string containing alphanumeric characters, punctuation, and symbols, using only whitespace as the delimiter.")
    public void splitShouldCorrectlyHandleStringsWithNumbersAndSymbols() {
        // Arrange
        String source = "item-1 price:$25.00";
        LinkedList expected = createExpectedList("item-1", "price:$25.00");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
}