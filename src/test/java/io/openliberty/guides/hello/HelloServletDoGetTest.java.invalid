package io.openliberty.guides.hello;import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;

public class HelloServletDoGetTest {
    private HelloServlet helloServlet;
    private HttpServletRequest request;
    private HttpServletResponse response;
    private StringWriter responseWriter;
    @BeforeEach
    public void setUp() {
        helloServlet = new HelloServlet();
        request = Mockito.mock(HttpServletRequest.class);
        response = Mockito.mock(HttpServletResponse.class);
        responseWriter = new StringWriter();
    }
    @Test
    @Tag("valid")
    public void verifyResponseContentForDoGet() throws ServletException, IOException {
        // Arrange
        when(response.getWriter()).thenReturn(new PrintWriter(responseWriter));
        // Act
        helloServlet.doGet(request, response);
        // Assert
        assertEquals("Hello! Is Gradle working for you?\n", responseWriter.toString());
    }
}