package io.openliberty.guides.hello;import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.when;
import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.annotation.WebServlet;

@ExtendWith(MockitoExtension.class)
public class HelloServletDoGetTest {
    @Mock
    private HttpServletRequest request;
    @Mock
    private HttpServletResponse response;
    
    private HelloServlet helloServlet;
    @BeforeEach
    public void setUp() {
        helloServlet = new HelloServlet();
    }
    @Test
    @Tag("valid")
    public void doGetWritesExpectedMessageToResponse() throws IOException, ServletException {
        // Arrange
        StringWriter stringWriter = new StringWriter();
        PrintWriter printWriter = new PrintWriter(stringWriter);
        when(response.getWriter()).thenReturn(printWriter);
        String expectedMessage = "Hello! Is Gradle working for you?\n";
        
        // Act
        helloServlet.doGet(request, response);
        
        // Assert
        assertEquals(expectedMessage, stringWriter.toString());
    }
    @Test
    @Tag("valid")
    public void doPostDelegatesToDoGet() throws IOException, ServletException {
        // Arrange
        StringWriter stringWriter = new StringWriter();
        PrintWriter printWriter = new PrintWriter(stringWriter);
        when(response.getWriter()).thenReturn(printWriter);
        String expectedMessage = "Hello! Is Gradle working for you?\n";
        
        // Act
        helloServlet.doPost(request, response);
        
        // Assert
        assertEquals(expectedMessage, stringWriter.toString());
    }
    @Test
    @Tag("invalid")
    public void doGetHandlesIOExceptionFromGetWriter() throws IOException {
        // Arrange
        when(response.getWriter()).thenThrow(new IOException());
        
        // Act & Assert
        assertThrows(IOException.class, () -> {
            helloServlet.doGet(request, response);
        });
    }
    @Test
    @Tag("invalid")
    public void doPostHandlesIOExceptionFromGetWriter() throws IOException {
        // Arrange
        when(response.getWriter()).thenThrow(new IOException());
        
        // Act & Assert
        assertThrows(IOException.class, () -> {
            helloServlet.doPost(request, response);
        });
    }
}