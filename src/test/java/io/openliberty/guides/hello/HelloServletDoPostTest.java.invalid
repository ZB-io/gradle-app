package io.openliberty.guides.hello;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.*;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;

public class HelloServletDoPostTest {
    @Mock
    private HttpServletRequest mockRequest;
    @Mock
    private HttpServletResponse mockResponse;
    private HelloServlet servlet;
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
        servlet = new HelloServlet();
    }
    @Test
    @Tag("valid")
    public void doPostDelegatesToDoGetSuccessfully() throws IOException, ServletException {
        // Arrange
        StringWriter stringWriter = new StringWriter();
        PrintWriter printWriter = new PrintWriter(stringWriter);
        when(mockResponse.getWriter()).thenReturn(printWriter);
        // Act
        servlet.doPost(mockRequest, mockResponse);
        printWriter.flush();
        // Assert
        assertEquals("Hello! Is Gradle working for you?\n", stringWriter.toString());
        verify(mockResponse, times(1)).getWriter();
    }
    @Test
    @Tag("invalid")
    public void doPostPropagatesIOExceptionWhenGetWriterFails() throws IOException, ServletException {
        // Arrange
        when(mockResponse.getWriter()).thenThrow(new IOException("Writer retrieval failed"));
        // Act & Assert
        assertThrows(IOException.class, () -> servlet.doPost(mockRequest, mockResponse));
        verify(mockResponse, times(1)).getWriter();
    }
    @Test
    @Tag("invalid")
    public void doPostPropagatesServletExceptionFromDoGet() throws ServletException, IOException {
        // Arrange
        HelloServlet servletSpy = spy(servlet);
        doThrow(new ServletException("doGet failed intentionally")).when(servletSpy).doGet(any(HttpServletRequest.class), any(HttpServletResponse.class));
        // Act & Assert
        assertThrows(ServletException.class, () -> servletSpy.doPost(mockRequest, mockResponse));
        verify(servletSpy, times(1)).doGet(mockRequest, mockResponse);
    }
}