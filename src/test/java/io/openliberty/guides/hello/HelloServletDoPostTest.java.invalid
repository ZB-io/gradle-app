@WebServlet("/hello")
public class HelloServletDoPostTest extends HttpServlet {
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        doGet(request, response);
    }
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        if (request.getMethod().equalsIgnoreCase("GET")) {
            response.getWriter().println("Hello! Is Gradle working for you?\n");
        } else {
            throw new ServletException("Invalid request method");
        }
    }
}public class HelloServletDoPostTest extends HttpServletRequest {
