    public void doPostShouldPropagateIOExceptionFromDoGet() throws ServletException, IOException {
        doThrow(new IOException("Test IOException")).when(servletSpy).doGet(mockRequest, mockResponse);
        assertThrows(IOException.class, () -> {
            servletSpy.doPost(mockRequest, mockResponse);
        });
    }
    @Test
    @Tag("boundary")
    public void doPostShouldThrowNullPointerExceptionWhenResponseIsNull() {
        assertThrows(NullPointerException.class, () -> {
            servletSpy.doPost(mockRequest, null);
        });
