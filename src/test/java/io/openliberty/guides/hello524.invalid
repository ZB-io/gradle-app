@ExtendWith(MockitoExtension.class)
class hello524 {
    @Mock
    private HttpServletRequest mockRequest;
    @Mock
    private HttpServletResponse mockResponse;
    @Spy
    private HelloServlet servletSpy;
    @Test
    @Tag("valid")
    public void doPostShouldDelegateToDoGetSuccessfully() throws ServletException, IOException {
        servletSpy.doPost(mockRequest, mockResponse);
        verify(servletSpy, times(1)).doGet(mockRequest, mockResponse);
    }
    @Test
    @Tag("invalid")
