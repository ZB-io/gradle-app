package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

@WebMvcTest(CustomerController.class)
public class web241 {
    @Autowired
    private MockMvc mockMvc;
    @MockBean
    private CustomerService customerService;
    @Autowired
    private ObjectMapper objectMapper;
    @Test
    @Tag("invalid")
    public void createCustomerWithNullRequestBody() throws Exception {
        mockMvc.perform(post("/api/customers")
                        .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isBadRequest());
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithMalformedJson() throws Exception {
        String malformedJson = "{\"name\": \"test\", \"email\": \"test@test.com\""; // Missing closing brace
        mockMvc.perform(post("/api/customers")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(malformedJson))
                .andExpect(status().isBadRequest());
    }
    @Test
    @Tag("integration")
    public void createCustomerWhenServiceLayerThrowsException() throws Exception {
        when(customerService.createCustomer(any(Customer.class))).thenThrow(new RuntimeException("Service layer error"));
        Customer customer = new Customer();
        customer.setName("Test Customer");
        customer.setEmail("test@example.com");
        String requestBody = objectMapper.writeValueAsString(customer);
        mockMvc.perform(post("/api/customers")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(requestBody))
                .andExpect(status().isInternalServerError());
    }
    @Test
    @Tag("valid")
    public void createCustomerWithExtraFieldsInPayload() throws Exception {
        Customer expectedCustomer = new Customer();
        expectedCustomer.setId(1L);
        expectedCustomer.setName("Test Customer");
        expectedCustomer.setEmail("test@example.com");
        when(customerService.createCustomer(any(Customer.class))).thenReturn(expectedCustomer);
        String customerJsonWithExtraField = "{\"name\":\"Test Customer\", \"email\":\"test@example.com\", \"extraField\":\"extraValue\"}";
        mockMvc.perform(post("/api/customers")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(customerJsonWithExtraField))
                .andExpect(status().isOk())
                .andExpect(content().json(objectMapper.writeValueAsString(expectedCustomer)));
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithInvalidFieldValues() throws Exception {
        // This test requires validation annotations on the Customer entity (e.g., @NotBlank, @Email)
        // and the @Valid annotation on the @RequestBody parameter in the controller's createCustomer method.
        // Without these, the request would be processed, and this test would fail.
        String invalidCustomerJson = "{\"name\":\"\", \"email\":\"not-an-email\"}";
        mockMvc.perform(post("/api/customers")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(invalidCustomerJson))
                .andExpect(status().isBadRequest());
    }
}