public class domain479 {
    @Test
    @Tag("valid")
    public void getNameWhenSetViaConstructor() {
        // Arrange
        Customer customer = new Customer("John Doe", "john.doe@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("John Doe", actualName);
    }
    @Test
    @Tag("valid")
    public void getNameAfterUpdatingWithSetter() {
        // Arrange
        Customer customer = new Customer("Jane Smith", "jane.smith@example.com");
        customer.setName("Jane Miller");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("Jane Miller", actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameWhenNameIsNull() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualName = customer.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameWhenNameIsEmptyString() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("", actualName);
    }
    @Test
    @Tag("valid")
    public void getNameWhenNameIsWhitespace() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("   ");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("   ", actualName);
    }
    @Test
    @Tag("valid")
    public void getNameWithSpecialCharactersAndNumbers() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("Agent 007-O'Connell!");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("Agent 007-O'Connell!", actualName);
    }
}