package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.when;
import org.springframework.web.bind.annotation.*;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetAllCustomersTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @Test
    @Tag("valid")
    @DisplayName("Test retrieving all customers when the customer list is empty")
    void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        when(customerService.getAllCustomers()).thenReturn(Collections.emptyList());
        // Act
        List<Customer> result = customerController.getAllCustomers();
        // Assert
        assertNotNull(result, "The returned list should not be null.");
        assertTrue(result.isEmpty(), "The returned list should be empty.");
    }
    @Test
    @Tag("valid")
    @DisplayName("Test retrieving all customers when multiple customers exist")
    void getAllCustomersReturnsListWithMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer();
        customer1.setId(1L);
        customer1.setName("John Doe");
        customer1.setEmail("john.doe@example.com");
        Customer customer2 = new Customer();
        customer2.setId(2L);
        customer2.setName("Jane Smith");
        customer2.setEmail("jane.smith@example.com");
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2);
        when(customerService.getAllCustomers()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list should not be null.");
        assertEquals(expectedCustomers.size(), actualCustomers.size(), "The size of the returned list should match the expected size.");
        assertEquals(expectedCustomers, actualCustomers, "The returned list should match the expected list of customers.");
    }
    @Test
    @Tag("invalid")
    @DisplayName("Test controller behavior when the service layer throws an exception")
    void getAllCustomersPropagatesExceptionWhenServiceFails() {
        // Arrange
        String exceptionMessage = "Error connecting to the database";
        when(customerService.getAllCustomers()).thenThrow(new RuntimeException(exceptionMessage));
        // Act & Assert
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            customerController.getAllCustomers();
        }, "A RuntimeException should be thrown when the service fails.");
        assertEquals(exceptionMessage, thrownException.getMessage(), "The exception message should match the one from the service.");
    }
}