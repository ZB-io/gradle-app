package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.dao.DataAccessException;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class CustomerServiceDeleteCustomerTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("invalid")
    void deleteCustomerWithNullIdThrowsException() {
        // Arrange
        Long customerId = null;
        doThrow(new IllegalArgumentException("ID must not be null!")).when(customerRepository).deleteById(customerId);
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            customerService.deleteCustomer(customerId);
        });
        verify(customerRepository, times(1)).deleteById(customerId);
    }
    @Test
    @Tag("integration")
    void deleteCustomerPropagatesDataAccessExceptionOnRepositoryFailure() {
        // Arrange
        Long customerId = 123L;
        doThrow(new DataAccessException("Simulated repository failure") {
        }).when(customerRepository).deleteById(customerId);
        // Act & Assert
        assertThrows(DataAccessException.class, () -> {
            customerService.deleteCustomer(customerId);
        });
        verify(customerRepository, times(1)).deleteById(customerId);
    }
    @Test
    @Tag("valid")
    void deleteCustomerInvokesOnlyDeleteByIdAndNoOtherRepositoryMethods() {
        // Arrange
        Long customerId = 456L;
        doNothing().when(customerRepository).deleteById(customerId);
        // Act
        customerService.deleteCustomer(customerId);
        // Assert
        verify(customerRepository, times(1)).deleteById(customerId);
        verifyNoMoreInteractions(customerRepository);
    }
}