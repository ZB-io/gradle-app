package com.example.demo.service;import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import com.example.demo.domain.Customer;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

public class CustomerServiceDeleteCustomerTest {
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    public void setUp() {
        customerRepository = mock(CustomerRepository.class);
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    public void deleteExistingCustomer() {
        Long existingCustomerId = 1L;
        // Act
        customerService.deleteCustomer(existingCustomerId);
        // Assert
        verify(customerRepository, times(1)).deleteById(existingCustomerId);
    }
    @Test
    @Tag("invalid")
    public void deleteNonExistingCustomer() {
        Long nonExistingCustomerId = 999L;
        // Act
        customerService.deleteCustomer(nonExistingCustomerId);
        // Assert
        verify(customerRepository, times(1)).deleteById(nonExistingCustomerId);
    }
    @Test
    @Tag("boundary")
    public void deleteCustomerWithNullId() {
        Long nullCustomerId = null;
        // Act
        customerService.deleteCustomer(nullCustomerId);
        // Assert
        verify(customerRepository, never()).deleteById(anyLong());
    }
    @Test
    @Tag("integration")
    public void verifyRepositoryInteraction() {
        Long validCustomerId = 2L;
        // Act
        customerService.deleteCustomer(validCustomerId);
        // Assert
        verify(customerRepository, times(1)).deleteById(validCustomerId);
    }
}