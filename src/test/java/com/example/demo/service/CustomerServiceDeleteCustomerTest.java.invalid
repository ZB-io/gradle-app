package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

class CustomerServiceDeleteCustomerTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerService = new CustomerService(customerRepository);
    }
    
    @Test
    @Tag("valid")
    void deleteCustomerWithValidId() {
        // Arrange
        Long validId = 1L;
        // Act
        customerService.deleteCustomer(validId);
        // Assert
        verify(customerRepository, times(1)).deleteById(validId);
    }
    
    @Test
    @Tag("invalid")
    void deleteCustomerWithNullId() {
        // Arrange
        Long nullId = null;
        // Act
        customerService.deleteCustomer(nullId);
        // Assert
        verify(customerRepository, times(1)).deleteById(nullId);
    }
    
    @Test
    @Tag("boundary")
    void deleteCustomerWithZeroId() {
        // Arrange
        Long zeroId = 0L;
        // Act
        customerService.deleteCustomer(zeroId);
        // Assert
        verify(customerRepository, times(1)).deleteById(zeroId);
    }
    
    @Test
    @Tag("invalid")
    void deleteCustomerWithNegativeId() {
        // Arrange
        Long negativeId = -1L;
        // Act
        customerService.deleteCustomer(negativeId);
        // Assert
        verify(customerRepository, times(1)).deleteById(negativeId);
    }
    
    @Test
    @Tag("boundary")
    void deleteCustomerWithMaxLongId() {
        // Arrange
        Long maxLongId = Long.MAX_VALUE;
        // Act
        customerService.deleteCustomer(maxLongId);
        // Assert
        verify(customerRepository, times(1)).deleteById(maxLongId);
    }
    
    @Test
    @Tag("valid")
    void deleteNonExistentCustomerId() {
        // Arrange
        Long nonExistentId = 999L;
        // Act
        customerService.deleteCustomer(nonExistentId);
        // Assert
        verify(customerRepository, times(1)).deleteById(nonExistentId);
    }
    
    @Test
    @Tag("integration")
    void verifyRepositoryMethodCallCount() {
        // Arrange
        Long customerId = 5L;
        // Act
        customerService.deleteCustomer(customerId);
        // Assert
        verify(customerRepository, times(1)).deleteById(customerId);
        verifyNoMoreInteractions(customerRepository);
    }
    
    @Test
    @Tag("integration")
    void multipleSequentialDeleteOperations() {
        // Arrange
        Long firstId = 1L;
        Long secondId = 2L;
        Long thirdId = 3L;
        // Act
        customerService.deleteCustomer(firstId);
        customerService.deleteCustomer(secondId);
        customerService.deleteCustomer(thirdId);
        // Assert
        verify(customerRepository, times(1)).deleteById(firstId);
        verify(customerRepository, times(1)).deleteById(secondId);
        verify(customerRepository, times(1)).deleteById(thirdId);
        verify(customerRepository, times(3)).deleteById(any(Long.class));
    }
}