package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.mockito.ArgumentMatchers.anyLong;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;

class CustomerServiceGetCustomerByIdTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    public void retrieveExistingCustomerById() {
        // Arrange
        Long validId = 1L;
        Customer expectedCustomer = new Customer();
        when(customerRepository.findById(validId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> actualCustomer = customerService.getCustomerById(validId);
        // Assert
        assertTrue(actualCustomer.isPresent());
        assertEquals(expectedCustomer, actualCustomer.get());
    }
    @Test
    @Tag("invalid")
    public void retrieveNonExistingCustomerByInvalidId() {
        // Arrange
        Long invalidId = 999L;
        when(customerRepository.findById(invalidId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actualCustomer = customerService.getCustomerById(invalidId);
        // Assert
        assertTrue(actualCustomer.isEmpty());
    }
    @Test
    @Tag("boundary")
    public void handleNullIdInputGracefully() {
        // Arrange
        when(customerRepository.findById(null)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actualCustomer = customerService.getCustomerById(null);
        // Assert
        assertTrue(actualCustomer.isEmpty());
    }
    @Test
    @Tag("integration")
    public void verifyInteractionWithCustomerRepository() {
        // Arrange
        Long specificId = 2L;
        // Act
        customerService.getCustomerById(specificId);
        // Assert
        verify(customerRepository, times(1)).findById(specificId);
    }
}