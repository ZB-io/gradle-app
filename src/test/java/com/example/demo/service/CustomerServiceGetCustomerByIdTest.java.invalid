package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetCustomerByIdTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    private Customer customer;
    @BeforeEach
    public void setUp() {
        customer = new Customer(); // Initialize with appropriate values
        customer.setId(1L);
        customer.setName("John Doe");
        customer.setEmail("john.doe@example.com");
    }
    @Test
    @Tag("valid")
    public void retrieveExistingCustomerById() {
        Long validId = 1L;
        when(customerRepository.findById(validId)).thenReturn(Optional.of(customer));
        Optional<Customer> result = customerService.getCustomerById(validId);
        assertEquals(Optional.of(customer), result);
        verify(customerRepository, times(1)).findById(validId);
    }
    @Test
    @Tag("invalid")
    public void returnEmptyOptionalForNonExistentId() {
        Long nonExistentId = 999L;
        when(customerRepository.findById(nonExistentId)).thenReturn(Optional.empty());
        Optional<Customer> result = customerService.getCustomerById(nonExistentId);
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(nonExistentId);
    }
    @Test
    @Tag("boundary")
    public void handleNullIdGracefully() {
        Optional<Customer> result = customerService.getCustomerById(null);
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(null);
    }
    @Test
    @Tag("integration")
    public void verifyMethodInteractionWithRepository() {
        Long validId = 1L;
        when(customerRepository.findById(validId)).thenReturn(Optional.of(customer));
        customerService.getCustomerById(validId);
        verify(customerRepository, times(1)).findById(validId);
    }
}