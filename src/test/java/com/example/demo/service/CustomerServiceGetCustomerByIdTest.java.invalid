package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.dao.DataAccessException;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetCustomerByIdTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    @Test
    @Tag("valid")
    @DisplayName("Successfully retrieve an existing customer")
    public void getCustomerByIdWithExistingId() {
        // Arrange
        Long customerId = 1L;
        Customer expectedCustomer = new Customer();
        expectedCustomer.setId(customerId);
        expectedCustomer.setName("John Doe");
        expectedCustomer.setEmail("john.doe@example.com");
        when(customerRepository.findById(customerId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> result = customerService.getCustomerById(customerId);
        // Assert
        assertTrue(result.isPresent(), "Customer should be found for an existing ID.");
        assertEquals(expectedCustomer, result.get(), "The retrieved customer should match the expected one.");
        verify(customerRepository, times(1)).findById(customerId);
    }
    @Test
    @Tag("boundary")
    @DisplayName("Attempt to retrieve a customer with a non-existent ID")
    public void getCustomerByIdWithNonExistentId() {
        // Arrange
        Long customerId = 99L;
        when(customerRepository.findById(customerId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(customerId);
        // Assert
        assertTrue(result.isEmpty(), "Optional should be empty for a non-existent customer ID.");
        verify(customerRepository, times(1)).findById(customerId);
    }
    @Test
    @Tag("invalid")
    @DisplayName("Attempt to retrieve a customer with a null ID")
    public void getCustomerByIdWithNullId() {
        // Arrange
        when(customerRepository.findById(null)).thenThrow(new IllegalArgumentException("Id must not be null!"));
        // Act & Assert
        Exception exception = assertThrows(IllegalArgumentException.class, () -> {
            customerService.getCustomerById(null);
        });
        assertEquals("Id must not be null!", exception.getMessage());
        verify(customerRepository, times(1)).findById(null);
    }
    @Test
    @Tag("invalid")
    @DisplayName("Verify behavior when the repository throws a data access exception")
    public void getCustomerByIdWhenRepositoryThrowsException() {
        // Arrange
        Long customerId = 1L;
        DataAccessException repositoryException = new DataAccessException("Database unavailable") {};
        when(customerRepository.findById(customerId)).thenThrow(repositoryException);
        // Act & Assert
        Exception exception = assertThrows(DataAccessException.class, () -> {
            customerService.getCustomerById(customerId);
        });
        assertEquals(repositoryException, exception, "The service should propagate the exception from the repository.");
        verify(customerRepository, times(1)).findById(customerId);
    }
}