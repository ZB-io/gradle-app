package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.when;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.times;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    @Test
    @Tag("valid")
    public void getAllCustomersWhenRepositoryIsEmpty() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(Collections.emptyList());
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNotNull(result, "The returned list should not be null.");
        assertTrue(result.isEmpty(), "The returned list should be empty when the repository is empty.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllCustomersWhenMultipleCustomersExist() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2);
        when(customerRepository.findAll()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list should not be null.");
        assertEquals(expectedCustomers.size(), actualCustomers.size(), "The size of the returned list should match the expected size.");
        assertEquals(expectedCustomers, actualCustomers, "The returned list should contain the expected customers.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
    public void getAllCustomersWhenRepositoryThrowsException() {
        // Arrange
        when(customerRepository.findAll()).thenThrow(new RuntimeException("Database access error"));
        // Act & Assert
        assertThrows(RuntimeException.class, () -> {
            customerService.getAllCustomers();
        }, "A RuntimeException should be thrown when the repository fails.");
        verify(customerRepository, times(1)).findAll();
    }
}