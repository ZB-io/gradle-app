package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.when;
import org.springframework.stereotype.Service;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    private List<Customer> customerList;
    @BeforeEach
    public void setUp() {
        customerList = new ArrayList<>();
        customerList.add(new Customer(1L, "John Doe"));
        customerList.add(new Customer(2L, "Jane Doe"));
    }
    @Test
    @DisplayName("getAllCustomersReturnsNonEmptyList")
    public void testGetAllCustomersReturnsNonEmptyList() {
        when(customerRepository.findAll()).thenReturn(customerList);
        List<Customer> result = customerService.getAllCustomers();
        assertEquals(2, result.size());
    }
    @Test
    @DisplayName("getAllCustomersReturnsEmptyList")
    public void testGetAllCustomersReturnsEmptyList() {
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        List<Customer> result = customerService.getAllCustomers();
        assertEquals(0, result.size());
    }
    @Test
    @DisplayName("getAllCustomersThrowsExceptionWhenCustomerRepositoryIsNull")
    public void testGetAllCustomersThrowsExceptionWhenCustomerRepositoryIsNull() {
        customerService = new CustomerService(null);
        assertThrows(NullPointerException.class, () -> customerService.getAllCustomers());
    }
    @Test
    @DisplayName("getAllCustomersReturnsListWithCorrectData")
    public void testGetAllCustomersReturnsListWithCorrectData() {
        when(customerRepository.findAll()).thenReturn(customerList);
        List<Customer> result = customerService.getAllCustomers();
        assertEquals(1L, result.get(0).getId());
        assertEquals("John Doe", result.get(0).getName());
        assertEquals(2L, result.get(1).getId());
        assertEquals("Jane Doe", result.get(1).getName());
    }
    @Test
    @DisplayName("getAllCustomersReturnsListInCorrectOrder")
    public void testGetAllCustomersReturnsListInCorrectOrder() {
        customerList.sort((c1, c2) -> c1.getId().compareTo(c2.getId()));
        when(customerRepository.findAll()).thenReturn(customerList);
        List<Customer> result = customerService.getAllCustomers();
        assertEquals(customerList, result);
    }
}