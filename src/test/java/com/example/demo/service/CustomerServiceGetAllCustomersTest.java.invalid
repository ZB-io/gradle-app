package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.ArrayList;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

public class CustomerServiceGetAllCustomersTest {
    private CustomerService customerService;
    @Mock
    private CustomerRepository customerRepository;
    
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
        customerService = new CustomerService(customerRepository);
    }
    
    @Test
    @Tag("valid")
    public void returnsAllCustomersWhenRepositoryHasMultipleEntries() {
        List<Customer> mockCustomers = new ArrayList<>();
        mockCustomers.add(new Customer(1L, "John Doe", "john@example.com"));
        mockCustomers.add(new Customer(2L, "Jane Doe", "jane@example.com"));
        when(customerRepository.findAll()).thenReturn(mockCustomers);
        
        List<Customer> result = customerService.getAllCustomers();
        
        assertEquals(mockCustomers.size(), result.size(), "The number of customers returned should match the repository's list");
    }
    
    @Test
    @Tag("boundary")
    public void returnsEmptyListWhenRepositoryIsEmpty() {
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        
        List<Customer> result = customerService.getAllCustomers();
        
        assertEquals(0, result.size(), "The returned list should be empty when the repository has no entries");
    }
    
    @Test
    @Tag("invalid")
    public void handlesNullRepositoryResponseGracefully() {
        when(customerRepository.findAll()).thenReturn(null);
        
        List<Customer> result = customerService.getAllCustomers();
        
        // Suggestion: Update business logic to handle null response gracefully in the service method
        assertEquals(0, result.size(), "The method should handle null repository response gracefully");
    }
    
    @Test
    @Tag("integration")
    public void interactsWithRepositoryCorrectly() {
        customerService.getAllCustomers();
        
        verify(customerRepository, times(1)).findAll();
    }
    
    @Test
    @Tag("performance")
    public void performsWellWithLargeDataset() {
        List<Customer> largeDataSet = new ArrayList<>();
        for (int i = 0; i < 1000; i++) {
            largeDataSet.add(new Customer((long) i, "Customer " + i, "customer" + i + "@example.com"));
        }
        when(customerRepository.findAll()).thenReturn(largeDataSet);
        
        List<Customer> result = customerService.getAllCustomers();
        
        assertEquals(largeDataSet.size(), result.size(), "The method should handle large datasets efficiently");
    }
}