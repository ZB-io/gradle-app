package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    @BeforeEach
    public void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        List<Customer> customers = customerService.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertTrue(customers.isEmpty());
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsListWithMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        List<Customer> mockCustomers = List.of(customer1, customer2);
        when(customerRepository.findAll()).thenReturn(mockCustomers);
        // Act
        List<Customer> customers = customerService.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(mockCustomers.size(), customers.size());
    }
    @Test
    @Tag("invalid")
    public void getAllCustomersHandlesNullRepositoryGracefully() {
        // Arrange
        customerService = new CustomerService(null);
        // Act & Assert
        assertThrows(NullPointerException.class, () -> customerService.getAllCustomers());
    }
    @Test
    @Tag("valid")
    public void getAllCustomersDoesNotModifyReturnedList() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        List<Customer> mockCustomers = List.of(customer1, customer2);
        when(customerRepository.findAll()).thenReturn(mockCustomers);
        // Act
        List<Customer> customers = customerService.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(mockCustomers, customers);
    }
    @Test
    @Tag("integration")
    public void getAllCustomersInteractsWithRepositoryOnce() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        customerService.getAllCustomers();
        // Assert
        verify(customerRepository, times(1)).findAll();
    }
}