package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsEmptyListWhenRepositoryHasNoCustomers() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(Collections.emptyList());
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNotNull(result, "The returned list should not be null.");
        assertTrue(result.isEmpty(), "The returned list should be empty.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsListWithMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer();
        customer1.setId(1L);
        customer1.setName("John Doe");
        customer1.setEmail("john.doe@example.com");
        Customer customer2 = new Customer();
        customer2.setId(2L);
        customer2.setName("Jane Doe");
        customer2.setEmail("jane.doe@example.com");
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2);
        when(customerRepository.findAll()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list should not be null.");
        assertEquals(expectedCustomers.size(), actualCustomers.size(), "The size of the returned list should match the expected size.");
        assertEquals(expectedCustomers, actualCustomers, "The content of the returned list should match the expected list.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
    public void getAllCustomersPropagatesExceptionWhenRepositoryFails() {
        // Arrange
        String exceptionMessage = "Database unavailable";
        when(customerRepository.findAll()).thenThrow(new RuntimeException(exceptionMessage));
        // Act & Assert
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            customerService.getAllCustomers();
        }, "A RuntimeException should be thrown when the repository fails.");
        assertEquals(exceptionMessage, thrownException.getMessage(), "The exception message should match the one from the repository.");
        verify(customerRepository, times(1)).findAll();
    }
}