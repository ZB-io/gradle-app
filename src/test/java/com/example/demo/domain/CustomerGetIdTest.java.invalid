package com.example.demo.domain;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.lang.reflect.Field;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.*;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

class CustomerGetIdTest {
    @Test
    @Tag("valid")
    public void getIdForNewCustomerReturnsNull() {
        // Arrange
        Customer customer = new Customer("John Doe", "john.doe@example.com");
        // Act
        Long actualId = customer.getId();
        // Assert
        assertNull(actualId);
    }
    @Test
    @Tag("valid")
    public void getIdReturnsAssignedValue() throws NoSuchFieldException, IllegalAccessException {
        // Arrange
        Customer customer = new Customer("Jane Doe", "jane.doe@example.com");
        Long expectedId = 123L;
        Field idField = Customer.class.getDeclaredField("id");
        idField.setAccessible(true);
        idField.set(customer, expectedId);
        // Act
        Long actualId = customer.getId();
        // Assert
        assertEquals(expectedId, actualId);
    }
}