package com.example.demo.domain;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.lang.reflect.Field;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

class CustomerGetIdTest {
    @Test
    @Tag("valid")
    public void getIdReturnsNullForNewCustomerInstance() {
        // Arrange
        Customer customer = new Customer("John Doe", "john.doe@example.com");
        // Act
        Long actualId = customer.getId();
        // Assert
        assertNull(actualId, "getId() should return null for a new, unpersisted customer.");
    }
    @Test
    @Tag("valid")
    public void getIdReturnsAssignedIdValue() throws NoSuchFieldException, IllegalAccessException {
        // Arrange
        Customer customer = new Customer("Jane Doe", "jane.doe@example.com");
        Long expectedId = 101L;
        Field idField = Customer.class.getDeclaredField("id");
        idField.setAccessible(true);
        idField.set(customer, expectedId);
        // Act
        Long actualId = customer.getId();
        // Assert
        assertEquals(expectedId, actualId, "getId() should return the value assigned via reflection.");
    }
    @Test
    @Tag("boundary")
    public void getIdReturnsMaxValueForId() throws NoSuchFieldException, IllegalAccessException {
        // Arrange
        Customer customer = new Customer("Max Value", "max@example.com");
        Long expectedId = Long.MAX_VALUE;
        Field idField = Customer.class.getDeclaredField("id");
        idField.setAccessible(true);
        idField.set(customer, expectedId);
        // Act
        Long actualId = customer.getId();
        // Assert
        assertEquals(expectedId, actualId, "getId() should correctly return Long.MAX_VALUE.");
    }
}