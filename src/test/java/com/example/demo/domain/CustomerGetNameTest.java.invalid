package com.example.demo.domain;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

public class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void retrieveNameWhenNameIsSet() {
        // Arrange
        Customer customer = new Customer("John Doe", "john.doe@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("John Doe", actualName);
    }
    @Test
    @Tag("boundary")
    public void retrieveNameWhenNameIsNull() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualName = customer.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("valid")
    public void retrieveNameAfterNameChange() {
        // Arrange
        Customer customer = new Customer("Jane Doe", "jane.doe@example.com");
        customer.setName("Alice Smith"); // Assuming setName method exists
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals("Alice Smith", actualName);
    }
    @Test
    @Tag("integration")
    public void retrieveNameForMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer("Tom", "tom@example.com");
        Customer customer2 = new Customer("Jerry", "jerry@example.com");
        // Act
        String actualName1 = customer1.getName();
        String actualName2 = customer2.getName();
        // Assert
        assertEquals("Tom", actualName1);
        assertEquals("Jerry", actualName2);
    }
}