package com.example.demo.domain;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void getNameReturnsCorrectValue() {
        // Arrange
        Customer customer = new Customer();
        String name = "John Doe";
        customer.setName(name);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) name, (String) result);
    }
    @Test
    @Tag("invalid")
    public void getNameReturnsNullForNewCustomer() {
        // Arrange
        Customer customer = new Customer(); // Name is not set
        // Act
        String result = customer.getName();
        // Assert
        assertNull((String) result);
    }
    @Test
    @Tag("valid")
    public void updatedNameIsReturnedAccurately() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("Initial Name");
        String updatedName = "Updated Name";
        customer.setName(updatedName);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) updatedName, (String) result);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsEmptyString() {
        // Arrange
        Customer customer = new Customer();
        String emptyName = ""; // Set empty string
        customer.setName(emptyName);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) emptyName, (String) result);
    }
    @Test
    @Tag("boundary")
    public void getNameHandlesWhitespaceAsName() {
        // Arrange
        Customer customer = new Customer();
        String whitespaceName = "   "; // Name with whitespace characters
        customer.setName(whitespaceName);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) whitespaceName, (String) result);
    }
    @Test
    @Tag("valid")
    public void getNameHandlesSpecialCharacters() {
        // Arrange
        Customer customer = new Customer();
        String specialName = "@$%!&#*"; // Name with special characters
        customer.setName(specialName);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) specialName, (String) result);
    }
    @Test
    @Tag("integration")
    public void getNameHandlesConcurrentAccess() throws InterruptedException {
        // Arrange
        Customer customer = new Customer();
        String name = "Concurrent Name";
        customer.setName(name);
        final String[] results = new String[10];
        Thread[] threads = new Thread[10];
        for (int i = 0; i < threads.length; i++) {
            threads[i] = new Thread(() -> {
                synchronized (customer) { // Synchronizing access to prevent race condition
                    results[(int) (Thread.currentThread().getId() % 10)] = customer.getName(); // Store result
                }
            });
        }
        // Act
        for (Thread thread : threads) {
            thread.start();
        }
        for (Thread thread : threads) {
            thread.join();
        }
        // Assert
        for (String result : results) {
            assertEquals((String) name, (String) result);
        }
    }
    @Test
    @Tag("boundary")
    public void getNameHandlesLongStrings() {
        // Arrange
        Customer customer = new Customer();
        String longName = "a".repeat(10000); // Long string
        customer.setName(longName);
        // Act
        String result = customer.getName();
        // Assert
        assertEquals((String) longName, (String) result);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsNullAfterReset() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("Temporary Name");
        customer.setName(null); // Reset to null
        // Act
        String result = customer.getName();
        // Assert
        assertNull((String) result);
    }
}