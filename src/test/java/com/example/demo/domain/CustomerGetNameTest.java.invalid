package com.example.demo.domain;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.*;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void customerCreationWithParameterizedConstructor() {
        String name = "John Doe";
        String email = "john.doe@example.com";
        Customer customer = new Customer(name, email);
        assertEquals(name, customer.getName());
        assertEquals(email, customer.getEmail());
        assertNull(customer.getId());
    }
    @Test
    @Tag("valid")
    public void customerCreationWithNoArgumentConstructor() {
        Customer customer = new Customer();
        assertNull(customer.getName());
        assertNull(customer.getEmail());
        assertNull(customer.getId());
    }
    @Test
    @Tag("valid")
    public void setNameSuccessfullyUpdatesName() {
        Customer customer = new Customer();
        String newName = "Jane Smith";
        customer.setName(newName);
        assertEquals(newName, customer.getName());
    }
    @Test
    @Tag("valid")
    public void setEmailSuccessfullyUpdatesEmail() {
        Customer customer = new Customer("Initial Name", "initial@example.com");
        String newEmail = "updated@example.com";
        customer.setEmail(newEmail);
        assertEquals(newEmail, customer.getEmail());
    }
    @Test
    @Tag("boundary")
    public void customerCreationWithNullNameAndEmail() {
        Customer customer = new Customer(null, null);
        assertNull(customer.getName());
        assertNull(customer.getEmail());
    }
    @Test
    @Tag("boundary")
    public void customerCreationWithEmptyNameAndEmail() {
        Customer customer = new Customer("", "");
        assertEquals("", customer.getName());
        assertEquals("", customer.getEmail());
    }
    @Test
    @Tag("valid")
    public void setPropertiesToNullUsingSetters() {
        Customer customer = new Customer("Initial Name", "initial@email.com");
        customer.setName(null);
        customer.setEmail(null);
        assertNull(customer.getName());
        assertNull(customer.getEmail());
    }
    @Test
    @Tag("valid")
    public void gettersReturnCorrectInitialValues() {
        String name = "Clark Kent";
        String email = "clark.kent@dailyplanet.com";
        Customer customer = new Customer(name, email);
        assertEquals(name, customer.getName());
        assertEquals(email, customer.getEmail());
    }
}