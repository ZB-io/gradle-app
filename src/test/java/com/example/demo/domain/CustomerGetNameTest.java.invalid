package com.example.demo.domain;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.*;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void getNameReturnsNameSetViaConstructor() {
        // Arrange
        String expectedName = "John Doe";
        Customer customer = new Customer(expectedName, "john.doe@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsNullForObjectCreatedWithDefaultConstructor() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualName = customer.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsNameSetViaSetter() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "Jane Smith";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsUpdatedNameAfterModification() {
        // Arrange
        Customer customer = new Customer("Initial Name", "initial@example.com");
        String expectedName = "Updated Name";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsEmptyStringWhenSetAsEmpty() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsNullWhenNameIsExplicitlySetToNull() {
        // Arrange
        Customer customer = new Customer("Valid Name", "valid@example.com");
        customer.setName(null);
        // Act
        String actualName = customer.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsNameWithSpecialCharactersAndWhitespaceUnaltered() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "  Dr. O'Connell-Smith Jr. 4th!@#  ";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
}