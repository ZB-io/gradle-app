package com.example.demo.domain;import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;

class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void getNameReturnsSuccessfullyWhenNameIsSet() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "John Doe";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsNullWhenNameIsNotSet() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualName = customer.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsEmptyStringWhenNameIsSetToEmpty() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsWhitespaceStringWhenNameIsSetToWhitespace() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "   ";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsCorrectlyWhenNameContainsSpecialCharacters() {
        // Arrange
        Customer customer = new Customer();
        String expectedName = "Jane_Doe-123@";
        customer.setName(expectedName);
        // Act
        String actualName = customer.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
}