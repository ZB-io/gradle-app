package com.example.demo.domain;import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;

public class CustomerGetEmailTest {
    @Test
    @Tag("valid")
    public void getEmailReturnsValidEmail() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "john.doe@example.com";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsNullWhenEmailIsNotSet() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertNull(actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsNullWhenEmailIsExplicitlySetToNull() {
        // Arrange
        Customer customer = new Customer();
        customer.setEmail(null);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertNull(actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsEmptyString() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
    @Test
    @Tag("valid")
    public void getEmailReturnsEmailWithValidSpecialCharacters() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "user.name+alias@sub-domain.co.uk";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
    @Test
    @Tag("valid")
    public void getEmailReturnsUpdatedEmailAfterChange() {
        // Arrange
        Customer customer = new Customer();
        customer.setEmail("initial@example.com");
        String updatedEmail = "updated@example.com";
        customer.setEmail(updatedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(updatedEmail, actualEmail);
    }
}