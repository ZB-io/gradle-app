package com.example.demo.domain;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

public class CustomerGetEmailTest {
    @Test
    @Tag("valid")
    public void getEmailReturnsSuccessfullySetEmail() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "test.user@example.com";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsNullWhenEmailIsNotSet() {
        // Arrange
        Customer customer = new Customer();
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertNull(actualEmail);
    }
    @Test
    @Tag("valid")
    public void getEmailReturnsNullWhenEmailIsExplicitlySetToNull() {
        // Arrange
        Customer customer = new Customer();
        customer.setEmail(null);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertNull(actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsEmptyStringWhenSet() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
    @Test
    @Tag("valid")
    public void getEmailReturnsUpdatedEmailAfterChange() {
        // Arrange
        Customer customer = new Customer();
        customer.setEmail("initial.email@example.com");
        String updatedEmail = "updated.email@example.com";
        customer.setEmail(updatedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(updatedEmail, actualEmail);
    }
    @Test
    @Tag("boundary")
    public void getEmailReturnsEmailWithWhitespace() {
        // Arrange
        Customer customer = new Customer();
        String expectedEmail = "  spaced.email@example.com  ";
        customer.setEmail(expectedEmail);
        // Act
        String actualEmail = customer.getEmail();
        // Assert
        assertEquals(expectedEmail, actualEmail);
    }
}