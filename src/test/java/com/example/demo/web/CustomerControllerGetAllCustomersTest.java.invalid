package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import java.util.Optional;
import org.springframework.web.bind.annotation.*;

@ExtendWith(MockitoExtension.class)
public class CustomerControllerGetAllCustomersTest {
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    public void setUp() {
        customerService = mock(CustomerService.class);
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        when(customerService.getAllCustomers()).thenReturn(Collections.emptyList());
        // Act
        List<Customer> result = customerController.getAllCustomers();
        // Assert
        assertEquals(0, result.size(), "The returned list should be empty when no customers exist");
        verify(customerService).getAllCustomers();
    }
    
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsListOfCustomers() {
        // Arrange
        Customer mockCustomer1 = new Customer(); 
        Customer mockCustomer2 = new Customer(); 
        mockCustomer1.setId(1L); // Assuming these are valid fields of the Customer entity
        mockCustomer1.setName("John Doe");
        mockCustomer1.setEmail("johndoe@example.com");
        
        mockCustomer2.setId(2L); 
        mockCustomer2.setName("Jane Doe");
        mockCustomer2.setEmail("janedoe@example.com");
        List<Customer> mockCustomerList = List.of(mockCustomer1, mockCustomer2);
        when(customerService.getAllCustomers()).thenReturn(mockCustomerList);
        // Act
        List<Customer> result = customerController.getAllCustomers();
        // Assert
        assertEquals(mockCustomerList.size(), result.size(), "The returned list size should match the mock list size");
        assertEquals(mockCustomerList, result, "The returned customers should match the mock customers");
        verify(customerService).getAllCustomers();
    }
}