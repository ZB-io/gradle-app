package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerControllerGetAllCustomersTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @BeforeEach
    public void setUp() {
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsEmptyListWhenNoCustomers() {
        // Arrange
        when(customerService.getAllCustomers()).thenReturn(new ArrayList<>());
        // Act
        List<Customer> customers = customerController.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(0, customers.size());
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsListWithMultipleCustomers() {
        // Arrange
        List<Customer> mockCustomers = new ArrayList<>();
        mockCustomers.add(new Customer(1L, "John Doe", "john@example.com"));
        mockCustomers.add(new Customer(2L, "Jane Doe", "jane@example.com"));
        when(customerService.getAllCustomers()).thenReturn(mockCustomers);
        // Act
        List<Customer> customers = customerController.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(2, customers.size());
    }
    @Test
    @Tag("invalid")
    public void getAllCustomersHandlesNullResponseGracefully() {
        // Arrange
        when(customerService.getAllCustomers()).thenReturn(null);
        // Act
        List<Customer> customers = customerController.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(0, customers.size());
    }
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsListWithSingleCustomer() {
        // Arrange
        List<Customer> mockCustomers = new ArrayList<>();
        mockCustomers.add(new Customer(1L, "John Doe", "john@example.com"));
        when(customerService.getAllCustomers()).thenReturn(mockCustomers);
        // Act
        List<Customer> customers = customerController.getAllCustomers();
        // Assert
        assertNotNull(customers);
        assertEquals(1, customers.size());
    }
}