package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

public class CustomerControllerDeleteCustomerTest {
    
    @Mock
    private CustomerService customerService;
    
    private CustomerController customerController;
    
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerController = new CustomerController(customerService);
    }
    
    @Test
    @Tag("valid")
    void deleteCustomerWithValidId() {
        Long validId = 1L;
        
        customerController.deleteCustomer(validId);
        
        verify(customerService, times(1)).deleteCustomer(validId);
    }
    
    @Test
    @Tag("invalid")
    void deleteCustomerWithNullId() {
        Long nullId = null;
        
        customerController.deleteCustomer(nullId);
        
        verify(customerService, times(1)).deleteCustomer(nullId);
    }
    
    @Test
    @Tag("boundary")
    void deleteCustomerWithZeroId() {
        Long zeroId = 0L;
        
        customerController.deleteCustomer(zeroId);
        
        verify(customerService, times(1)).deleteCustomer(zeroId);
    }
    
    @Test
    @Tag("invalid")
    void deleteCustomerWithNegativeId() {
        Long negativeId = -1L;
        
        customerController.deleteCustomer(negativeId);
        
        verify(customerService, times(1)).deleteCustomer(negativeId);
    }
    
    @Test
    @Tag("boundary")
    void deleteCustomerWithLargeId() {
        Long largeId = Long.MAX_VALUE;
        
        customerController.deleteCustomer(largeId);
        
        verify(customerService, times(1)).deleteCustomer(largeId);
    }
    
    @Test
    @Tag("integration")
    void verifyServiceMethodInvocationCount() {
        Long testId = 123L;
        
        customerController.deleteCustomer(testId);
        
        verify(customerService, times(1)).deleteCustomer(testId);
        verifyNoMoreInteractions(customerService);
    }
    
    @Test
    @Tag("integration")
    void deleteCustomerExceptionPropagation() {
        Long testId = 456L;
        RuntimeException expectedException = new RuntimeException("Service exception");
        doThrow(expectedException).when(customerService).deleteCustomer(testId);
        
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            customerController.deleteCustomer(testId);
        });
        
        assertEquals("Service exception", thrownException.getMessage());
        verify(customerService, times(1)).deleteCustomer(testId);
    }
}