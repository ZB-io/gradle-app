import org.mockito.Mockito;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;

public class CustomerControllerDeleteCustomerTest {
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    public void setUp() {
        customerService = Mockito.mock(CustomerService.class);
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void deleteCustomerWithValidId() {
        // Arrange
        Long validCustomerId = 1L; // Assuming this is a valid customer ID
        doNothing().when(customerService).deleteCustomer(validCustomerId);
