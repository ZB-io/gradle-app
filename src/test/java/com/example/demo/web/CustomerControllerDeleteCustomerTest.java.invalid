import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import static org.mockito.Mockito.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

class CustomerControllerDeleteCustomerTest {
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        customerService = mock(CustomerService.class);
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void deleteCustomerWithValidId() {
        // Arrange
        Long validId = 1L; // Valid ID to test deletion logic
        
        // Act
        customerController.deleteCustomer(validId);
        
        // Assert
        verify(customerService, times(1)).deleteCustomer(validId);
        verifyNoMoreInteractions(customerService); // Ensuring no other service method is called
    }
    @Test
    @Tag("invalid")
    public void deleteCustomerWithInvalidId() {
        // Arrange
        Long invalidId = null; // Invalid case: Null ID provided
        try {
            // Act
            customerController.deleteCustomer(invalidId);
            fail("Exception should have been thrown for invalid ID");
        } catch (IllegalArgumentException e) {
            // Assert
            assertTrue(e.getMessage().contains("id must not be null")); // Assuming business logic handles null and throws IllegalArgumentException
        }
        // Ensure no service method is called in case of invalid ID
        verifyNoInteractions(customerService);
    }
}