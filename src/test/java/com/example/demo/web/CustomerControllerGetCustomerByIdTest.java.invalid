package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;

public class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    private CustomerController customerController;
    
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerController = new CustomerController(customerService);
    }
    
    @Test
    @Tag("valid")
    void getCustomerByIdWithValidIdReturnsCustomer() {
        // Arrange
        Long validId = 1L;
        Customer expectedCustomer = new Customer();
        when(customerService.getCustomerById(validId)).thenReturn(Optional.of(expectedCustomer));
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(validId);
        
        // Assert
        assertTrue(result.isPresent());
        assertEquals(expectedCustomer, result.get());
        verify(customerService, times(1)).getCustomerById(validId);
    }
    
    @Test
    @Tag("invalid")
    void getCustomerByIdWithInvalidIdReturnsEmptyOptional() {
        // Arrange
        Long invalidId = 999L;
        when(customerService.getCustomerById(invalidId)).thenReturn(Optional.empty());
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(invalidId);
        
        // Assert
        assertFalse(result.isPresent());
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(invalidId);
    }
    
    @Test
    @Tag("boundary")
    void getCustomerByIdWithNullIdParameter() {
        // Arrange
        Long nullId = null;
        when(customerService.getCustomerById(nullId)).thenReturn(Optional.empty());
        
        // Act
