package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;

class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerController = new CustomerController(customerService); // Ensure correct instantiation
    }
    @Test
    @Tag("valid")
    public void retrieveCustomerByValidId() {
        // Arrange
        Long validId = 1L;
        Customer expectedCustomer = new Customer(); // Initialize with valid data if needed
        when(customerService.getCustomerById(validId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> result = customerController.getCustomerById(validId);
        // Assert
        assertTrue(result.isPresent());
        assertEquals(expectedCustomer, result.get());
    }
    @Test
    @Tag("invalid")
    public void handleNonExistentCustomerId() {
        // Arrange
        Long nonExistentId = 999L;
        when(customerService.getCustomerById(nonExistentId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(nonExistentId);
        // Assert
        assertFalse(result.isPresent());
    }
    @Test
    @Tag("boundary")
    public void handleNullCustomerId() {
        // Act
        Optional<Customer> result = customerController.getCustomerById(null);
        // Assert
        assertNotNull(result);
        assertFalse(result.isPresent());
    }
    @Test
    @Tag("integration")
    public void verifyInteractionWithCustomerService() {
        // Arrange
        Long validId = 1L;
        when(customerService.getCustomerById(validId)).thenReturn(Optional.of(new Customer()));
        // Act
        customerController.getCustomerById(validId);
        // Assert
        verify(customerService, times(1)).getCustomerById(validId);
    }
}