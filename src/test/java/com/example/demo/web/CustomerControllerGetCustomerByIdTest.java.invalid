package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.web.bind.annotation.PathVariable;
import java.util.Optional;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.anyLong;
import static org.mockito.Mockito.when;
import org.springframework.web.bind.annotation.*;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @Test
    @Tag("valid")
    void getCustomerByIdWhenCustomerExists() {
        // Arrange
        Long customerId = 1L;
        Customer expectedCustomer = new Customer();
        expectedCustomer.setId(customerId);
        expectedCustomer.setName("John Doe");
        expectedCustomer.setEmail("john.doe@example.com");
        when(customerService.getCustomerById(customerId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> actualResult = customerController.getCustomerById(customerId);
        // Assert
        assertTrue(actualResult.isPresent(), "Customer should be present");
        assertEquals(expectedCustomer, actualResult.get(), "The returned customer should match the expected one");
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdWhenCustomerDoesNotExist() {
        // Arrange
        Long nonExistentCustomerId = 999L;
        when(customerService.getCustomerById(nonExistentCustomerId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(nonExistentCustomerId);
        // Assert
        assertTrue(result.isEmpty(), "The Optional should be empty for a non-existent customer");
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdWhenServiceThrowsException() {
        // Arrange
        Long customerId = 1L;
        String exceptionMessage = "Database connection failed";
        when(customerService.getCustomerById(customerId)).thenThrow(new RuntimeException(exceptionMessage));
        // Act & Assert
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            customerController.getCustomerById(customerId);
        }, "A RuntimeException should be thrown");
        assertEquals(exceptionMessage, thrownException.getMessage(), "The exception message should be propagated correctly");
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithNegativeId() {
        // Arrange
        Long negativeId = -1L;
        when(customerService.getCustomerById(negativeId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(negativeId);
        // Assert
        assertTrue(result.isEmpty(), "The Optional should be empty when a negative ID is provided");
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithZeroId() {
        // Arrange
        Long zeroId = 0L;
        when(customerService.getCustomerById(zeroId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(zeroId);
        // Assert
        assertTrue(result.isEmpty(), "The Optional should be empty when the ID is zero");
    }
}