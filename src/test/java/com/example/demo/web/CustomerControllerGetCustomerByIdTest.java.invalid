package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.*;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @Test
    @Tag("valid")
    public void retrieveCustomerByIdWhenExists() {
        // Arrange
        Long validCustomerId = 1L; 
        Customer mockCustomer = new Customer();
        mockCustomer.setId(validCustomerId); 
        mockCustomer.setName("Test Name");
        mockCustomer.setEmail("test@example.com");
        
        Optional<Customer> expected = Optional.of(mockCustomer);
        when(customerService.getCustomerById(validCustomerId)).thenReturn(expected);
        // Act
        Optional<Customer> actual = customerController.getCustomerById(validCustomerId);
        // Assert
        assertTrue(actual.isPresent(), "Expected customer should not be empty");
        assertEquals(expected.get().getId(), actual.get().getId(), "IDs should match");
        assertEquals(expected.get().getName(), actual.get().getName(), "Names should match");
        assertEquals(expected.get().getEmail(), actual.get().getEmail(), "Emails should match");
        verify(customerService, times(1)).getCustomerById(validCustomerId);
    }
    @Test
    @Tag("invalid")
    public void retrieveCustomerByIdWhenDoesNotExist() {
        // Arrange
        Long nonExistentCustomerId = 2L; 
        when(customerService.getCustomerById(nonExistentCustomerId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actual = customerController.getCustomerById(nonExistentCustomerId);
        // Assert
        assertTrue(actual.isEmpty(), "Returned Optional should be empty for non-existent customer ID");
        verify(customerService, times(1)).getCustomerById(nonExistentCustomerId);
    }
    @Test
    @Tag("invalid")
    public void retrieveCustomerByIdWithNullInput() {
        // Arrange
        when(customerService.getCustomerById(null)).thenThrow(new IllegalArgumentException("ID cannot be null"));
        // Act & Assert
        assertThrows(IllegalArgumentException.class, 
            () -> customerController.getCustomerById(null),
            "Null input should throw an exception");
        verify(customerService, times(1)).getCustomerById(null);
    }
    @Test
    @Tag("boundary")
    public void retrieveCustomerByIdWithEdgeCaseIds() {
        // Arrange
        Long negativeId = -1L;
        Long zeroId = 0L;
        Long largeId = Long.MAX_VALUE;
        when(customerService.getCustomerById(negativeId)).thenReturn(Optional.empty());
        when(customerService.getCustomerById(zeroId)).thenReturn(Optional.empty());
        when(customerService.getCustomerById(largeId)).thenReturn(Optional.empty());
        // Act & Assert
        assertTrue(customerController.getCustomerById(negativeId).isEmpty(), "Returned Optional should be empty for negative ID");
        assertTrue(customerController.getCustomerById(zeroId).isEmpty(), "Returned Optional should be empty for zero ID");
        assertTrue(customerController.getCustomerById(largeId).isEmpty(), "Returned Optional should be empty for large ID");
        verify(customerService, times(1)).getCustomerById(negativeId);
        verify(customerService, times(1)).getCustomerById(zeroId);
        verify(customerService, times(1)).getCustomerById(largeId);
    }
    @Test
    @Tag("integration")
    public void validateCustomerServiceIntegrationInGetCustomerById() {
        // Arrange
        Long inputId = 1L;
        when(customerService.getCustomerById(inputId)).thenReturn(Optional.empty());
        // Act
        customerController.getCustomerById(inputId);
        // Assert
        verify(customerService, times(1)).getCustomerById(inputId);
    }
    @Test
    @Tag("invalid")
    public void handleServiceExceptionPropagationInGetCustomerById() {
        // Arrange
        Long faultyId = 3L; 
        when(customerService.getCustomerById(faultyId)).thenThrow(new RuntimeException("Service Exception"));
        // Act & Assert
        assertThrows(RuntimeException.class, 
            () -> customerController.getCustomerById(faultyId),
            "Exception from service layer should be propagated to the controller");
        verify(customerService, times(1)).getCustomerById(faultyId);
    }
    @Test
    @Tag("boundary")
    public void handleBoundaryInputsInGetCustomerById() {
        // Arrange
        Long extremelyLargeId = Long.MAX_VALUE;
        when(customerService.getCustomerById(extremelyLargeId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actual = customerController.getCustomerById(extremelyLargeId);
        // Assert
        assertTrue(actual.isEmpty(), "Returned Optional<Customer> should be empty for boundary large ID value");
        verify(customerService, times(1)).getCustomerById(extremelyLargeId);
    }
}