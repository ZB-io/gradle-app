        // Assert
        assertFalse(result.isPresent());
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(nullId);
    }
    
    @Test
    @Tag("boundary")
    void getCustomerByIdWithZeroIdValue() {
        // Arrange
        Long zeroId = 0L;
        when(customerService.getCustomerById(zeroId)).thenReturn(Optional.empty());
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(zeroId);
        
        // Assert
        assertFalse(result.isPresent());
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(zeroId);
    }
    
    @Test
    @Tag("boundary")
    void getCustomerByIdWithNegativeIdValue() {
        // Arrange
        Long negativeId = -1L;
        when(customerService.getCustomerById(negativeId)).thenReturn(Optional.empty());
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(negativeId);
        
        // Assert
        assertFalse(result.isPresent());
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(negativeId);
    }
    
    @Test
    @Tag("boundary")
    void getCustomerByIdWithLargeIdValue() {
        // Arrange
        Long largeId = Long.MAX_VALUE;
        when(customerService.getCustomerById(largeId)).thenReturn(Optional.empty());
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(largeId);
        
        // Assert
        assertFalse(result.isPresent());
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(largeId);
    }
    
    @Test
    @Tag("valid")
    void getCustomerByIdWithValidIdVerifiesServiceInteraction() {
        // Arrange
        Long validId = 42L;
        Customer customer = new Customer();
        when(customerService.getCustomerById(validId)).thenReturn(Optional.of(customer));
        
        // Act
        Optional<Customer> result = customerController.getCustomerById(validId);
        
        // Assert
        assertNotNull(result);
        assertTrue(result.isPresent());
        verify(customerService, times(1)).getCustomerById(validId);
        verifyNoMoreInteractions(customerService);
    }
    
    @Test
    @Tag("integration")
    void getCustomerByIdMultipleCallsWithDifferentIds() {
        // Arrange
        Long id1 = 1L;
        Long id2 = 2L;
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        
        when(customerService.getCustomerById(id1)).thenReturn(Optional.of(customer1));
        when(customerService.getCustomerById(id2)).thenReturn(Optional.of(customer2));
        
        // Act
        Optional<Customer> result1 = customerController.getCustomerById(id1);
        Optional<Customer> result2 = customerController.getCustomerById(id2);
        
