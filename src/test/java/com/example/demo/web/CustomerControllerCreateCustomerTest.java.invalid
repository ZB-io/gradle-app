package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

class CustomerControllerCreateCustomerTest {
    @Mock
    private CustomerService customerService;
    
    @InjectMocks
    private CustomerController customerController;
    
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    
    @Test
    @Tag("valid")
    public void createCustomerWithValidData() {
        Customer validCustomer = new Customer();
        validCustomer.setName("John Doe");
        validCustomer.setEmail("john.doe@example.com");
        
        when(customerService.createCustomer(validCustomer)).thenReturn(validCustomer);
        
        Customer result = customerController.createCustomer(validCustomer);
        
        assertEquals(validCustomer, result);
        verify(customerService, times(1)).createCustomer(validCustomer);
    }
    
    @Test
    @Tag("invalid")
    public void handleNullCustomerInput() {
        Customer nullCustomer = null;
        
        assertDoesNotThrow(() -> customerController.createCustomer(nullCustomer));
        verify(customerService, times(0)).createCustomer(nullCustomer);
    }
    
    @Test
    @Tag("invalid")
    public void createCustomerWithMissingFields() {
        Customer incompleteCustomer = new Customer();
        incompleteCustomer.setName("John Doe");
        
        when(customerService.createCustomer(incompleteCustomer)).thenThrow(new IllegalArgumentException("Missing required fields"));
        
        Exception exception = assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(incompleteCustomer);
        });
        
        assertEquals("Missing required fields", exception.getMessage());
        verify(customerService, times(1)).createCustomer(incompleteCustomer);
    }
    
    @Test
    @Tag("invalid")
    public void handleDuplicateCustomerCreation() {
        Customer duplicateCustomer = new Customer();
        duplicateCustomer.setName("John Doe");
        duplicateCustomer.setEmail("john.doe@example.com");
        
        when(customerService.createCustomer(duplicateCustomer)).thenThrow(new IllegalStateException("Customer already exists"));
        
        Exception exception = assertThrows(IllegalStateException.class, () -> {
            customerController.createCustomer(duplicateCustomer);
        });
        
        assertEquals("Customer already exists", exception.getMessage());
        verify(customerService, times(1)).createCustomer(duplicateCustomer);
    }
    
    @Test
    @Tag("valid")
    public void createCustomerWithSpecialCharacters() {
        Customer specialCharCustomer = new Customer();
        specialCharCustomer.setName("J@hn D*e");
        specialCharCustomer.setEmail("john.doe@example.com");
        
        when(customerService.createCustomer(specialCharCustomer)).thenReturn(specialCharCustomer);
        
        Customer result = customerController.createCustomer(specialCharCustomer);
        
        assertEquals(specialCharCustomer, result);
        verify(customerService, times(1)).createCustomer(specialCharCustomer);
    }
}