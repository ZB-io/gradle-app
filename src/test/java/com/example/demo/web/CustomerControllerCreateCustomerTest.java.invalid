package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

public class CustomerControllerCreateCustomerTest {
    @Mock
    private CustomerService customerService;
    private CustomerController customerController;
    
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        customerController = new CustomerController(customerService);
    }
    
    @Test
    @Tag("valid")
    void createCustomerWithValidData() {
        // Arrange
        Customer inputCustomer = new Customer();
        Customer expectedCustomer = new Customer();
        when(customerService.createCustomer(inputCustomer)).thenReturn(expectedCustomer);
        
        // Act
        Customer result = customerController.createCustomer(inputCustomer);
        
        // Assert
        assertNotNull(result);
        assertEquals(expectedCustomer, result);
        verify(customerService, times(1)).createCustomer(inputCustomer);
    }
    
    @Test
    @Tag("invalid")
    void createCustomerWithNullInput() {
        // Arrange
        Customer nullCustomer = null;
        when(customerService.createCustomer(nullCustomer)).thenThrow(new IllegalArgumentException("Customer cannot be null"));
        
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(nullCustomer);
        });
        verify(customerService, times(1)).createCustomer(nullCustomer);
    }
    
    @Test
    @Tag("boundary")
    void createCustomerWhenServiceReturnsNull() {
        // Arrange
        Customer inputCustomer = new Customer();
        when(customerService.createCustomer(inputCustomer)).thenReturn(null);
        
        // Act
        Customer result = customerController.createCustomer(inputCustomer);
        
        // Assert
        assertNull(result);
        verify(customerService, times(1)).createCustomer(inputCustomer);
    }
    
    @Test
    @Tag("boundary")
    void createCustomerWithEmptyObject() {
        // Arrange
        Customer emptyCustomer = new Customer();
        Customer expectedCustomer = new Customer();
        when(customerService.createCustomer(emptyCustomer)).thenReturn(expectedCustomer);
        
        // Act
        Customer result = customerController.createCustomer(emptyCustomer);
        
        // Assert
        assertNotNull(result);
        assertEquals(expectedCustomer, result);
        verify(customerService, times(1)).createCustomer(emptyCustomer);
    }
    
    @Test
    @Tag("invalid")
    void createCustomerWhenServiceThrowsException() {
        // Arrange
        Customer inputCustomer = new Customer();
        when(customerService.createCustomer(inputCustomer)).thenThrow(new RuntimeException("Database connection failed"));
        
        // Act & Assert
        assertThrows(RuntimeException.class, () -> {
            customerController.createCustomer(inputCustomer);
        });
        verify(customerService, times(1)).createCustomer(inputCustomer);
    }
    
    @Test
    @Tag("integration")
    void createMultipleCustomersSuccessively() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        Customer customer3 = new Customer();
        
        when(customerService.createCustomer(customer1)).thenReturn(customer1);
        when(customerService.createCustomer(customer2)).thenReturn(customer2);
        when(customerService.createCustomer(customer3)).thenReturn(customer3);
        
        // Act
        Customer result1 = customerController.createCustomer(customer1);
        Customer result2 = customerController.createCustomer(customer2);
        Customer result3 = customerController.createCustomer(customer3);
        
        // Assert
        assertEquals(customer1, result1);
        assertEquals(customer2, result2);
        assertEquals(customer3, result3);
        
        verify(customerService, times(1)).createCustomer(customer1);
        verify(customerService, times(1)).createCustomer(customer2);
        verify(customerService, times(1)).createCustomer(customer3);
        verify(customerService, times(3)).createCustomer(any(Customer.class));
    }
    
    @Test
    @Tag("integration")
    void createCustomerVerifiesServiceInteraction() {
        // Arrange
        Customer inputCustomer = new Customer();
        Customer returnedCustomer = new Customer();
        when(customerService.createCustomer(inputCustomer)).thenReturn(returnedCustomer);
        
        // Act
        Customer result = customerController.createCustomer(inputCustomer);
        
        // Assert
        assertNotNull(result);
        assertEquals(returnedCustomer, result);
        verify(customerService, times(1)).createCustomer(inputCustomer);
        verifyNoMoreInteractions(customerService);
    }
}