package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerControllerCreateCustomerTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @Test
    @Tag("valid")
    public void createCustomerWithValidDetails() {
        // Arrange
        Customer customerToCreate = new Customer();
        customerToCreate.setName("John Doe");
        customerToCreate.setEmail("john.doe@example.com");
        Customer expectedSavedCustomer = new Customer();
        expectedSavedCustomer.setId(1L);
        expectedSavedCustomer.setName("John Doe");
        expectedSavedCustomer.setEmail("john.doe@example.com");
        when(customerService.createCustomer(any(Customer.class))).thenReturn(expectedSavedCustomer);
        // Act
        Customer actualSavedCustomer = customerController.createCustomer(customerToCreate);
        // Assert
        assertNotNull(actualSavedCustomer);
        assertEquals(expectedSavedCustomer, actualSavedCustomer);
        verify(customerService, times(1)).createCustomer(customerToCreate);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithNullInput() {
        // Arrange
        when(customerService.createCustomer(null)).thenThrow(new IllegalArgumentException("Customer object cannot be null"));
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(null);
        });
        verify(customerService, times(1)).createCustomer(null);
    }
    @Test
    @Tag("boundary")
    public void createCustomerWithPartialDetails() {
        // Arrange
        Customer customerWithPartialDetails = new Customer();
        customerWithPartialDetails.setName("Jane Doe");
        Customer expectedCustomer = new Customer();
        expectedCustomer.setId(1L);
        expectedCustomer.setName("Jane Doe");
        when(customerService.createCustomer(customerWithPartialDetails)).thenReturn(expectedCustomer);
        // Act
        Customer result = customerController.createCustomer(customerWithPartialDetails);
        // Assert
        assertNotNull(result);
        assertEquals(expectedCustomer, result);
        verify(customerService, times(1)).createCustomer(customerWithPartialDetails);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWhenServiceLayerFails() {
        // Arrange
        Customer customerToCreate = new Customer();
        customerToCreate.setName("John Doe");
        customerToCreate.setEmail("john.doe@example.com");
        when(customerService.createCustomer(customerToCreate)).thenThrow(new RuntimeException("Database connection failed"));
        // Act & Assert
        assertThrows(RuntimeException.class, () -> {
            customerController.createCustomer(customerToCreate);
        });
        verify(customerService, times(1)).createCustomer(customerToCreate);
    }
}