package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void joinWithMultipleElements() {
        LinkedList<String> source = new LinkedList<>();
        source.add("Hello");
        source.add("World");
        source.add("Java");
        String expected = "Hello World Java";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void joinWithSingleElement() {
        LinkedList<String> source = new LinkedList<>();
        source.add("Singleton");
        String expected = "Singleton";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void joinWithEmptyList() {
        LinkedList<String> source = new LinkedList<>();
        String expected = "";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("invalid")
    public void joinWithNullList() {
        assertThrows(NullPointerException.class, () -> {
            StringUtils.join(null);
        });
    }
    @Test
    @Tag("valid")
    public void joinWithListContainingEmptyString() {
        LinkedList<String> source = new LinkedList<>();
        source.add("first");
        source.add("");
        source.add("last");
        String expected = "first  last";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void joinWithListContainingNullElement() {
        LinkedList<String> source = new LinkedList<>();
        source.add("start");
        source.add(null);
        source.add("end");
        String expected = "start  end";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void joinWithListContainingSpecialCharactersAndSpaces() {
        LinkedList<String> source = new LinkedList<>();
        source.add("item with spaces");
        source.add("item-with-hyphen");
        source.add("!@#$%^&*()");
        String expected = "item with spaces item-with-hyphen !@#$%^&*()";
        String actual = StringUtils.join(source);
        assertEquals(expected, actual);
    }
}