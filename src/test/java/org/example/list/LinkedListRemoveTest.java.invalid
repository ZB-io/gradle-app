package org.example.list;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class LinkedListRemoveTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("invalid")
    public void removeFromEmptyList() {
        // Arrange
        String element = "testElement";
        
        // Act
        boolean result = linkedList.remove(element);
        
        // Assert
        assertFalse(result);
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void removeSingleElement() {
        // Arrange
        String element = "singleElement";
        linkedList.add(element);
        
        // Act
        boolean result = linkedList.remove(element);
        
        // Assert
        assertTrue(result);
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void removeHeadElement() {
        // Arrange
        String headElement = "headElement";
        linkedList.add(headElement);
        linkedList.add("middleElement");
        linkedList.add("tailElement");
        
        // Act
        boolean result = linkedList.remove(headElement);
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("middleElement", linkedList.get(0));
    }
    @Test
    @Tag("valid")
    public void removeTailElement() {
        // Arrange
        linkedList.add("headElement");
        linkedList.add("middleElement");
        String tailElement = "tailElement";
        linkedList.add(tailElement);
        
        // Act
        boolean result = linkedList.remove(tailElement);
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("middleElement", linkedList.get(1));
    }
    @Test
    @Tag("valid")
    public void removeMiddleElement() {
        // Arrange
        linkedList.add("headElement");
        String middleElement = "middleElement";
        linkedList.add(middleElement);
        linkedList.add("tailElement");
        
        // Act
        boolean result = linkedList.remove(middleElement);
        
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("tailElement", linkedList.get(1));
    }
    @Test
    @Tag("invalid")
    public void removeNullElement() {
        // Arrange
        linkedList.add("headElement");
        linkedList.add("middleElement");
        linkedList.add("tailElement");
        
        // Act
        boolean result = linkedList.remove(null);
        
        // Assert
        assertFalse(result);
        assertEquals(3, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void removeElementWithDuplicates() {
        // Arrange
        String duplicateElement = "duplicateElement";
        linkedList.add("headElement");
        linkedList.add(duplicateElement);
        linkedList.add("middleElement");
        linkedList.add(duplicateElement);
        linkedList.add("tailElement");
        
        // Act
        boolean result = linkedList.remove(duplicateElement);
        
        // Assert
        assertTrue(result);
        assertEquals(4, linkedList.size());
        assertEquals("middleElement", linkedList.get(1));
    }
}