package org.example.list;

public class LinkedListRemoveTest {
    private Node head;
    // other fields and methods
    public boolean remove(String element) {
        boolean result = false;
        Node previousIt = null;
        Node it = head;
        while (!result && it != null) {
            if (element.equals(it.data)) {
                result = true;
                unlink(previousIt, it);
            }
            previousIt = it;
            it = it.next;
        }
        return result;
    }
    private void unlink(Node previousIt, Node it) {
        if (previousIt == null) {
            head = it.next;
        } else {
            previousIt.next = it.next;
        }
    }
}