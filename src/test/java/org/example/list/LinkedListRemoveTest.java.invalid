package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;

class LinkedListRemoveTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    void removeMiddleElementFromList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        // Act
        boolean result = linkedList.remove("second");
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
    }
    @Test
    @Tag("valid")
    void removeFirstElementFromList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        // Act
        boolean result = linkedList.remove("first");
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("second", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
    }
    @Test
    @Tag("valid")
    void removeLastElementFromList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        // Act
        boolean result = linkedList.remove("third");
        // Assert
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("second", linkedList.get(1));
        assertThrows(IndexOutOfBoundsException.class, () -> linkedList.get(2));
    }
    @Test
    @Tag("boundary")
    void removeOnlyElementFromList() {
        // Arrange
        linkedList.add("single");
        // Act
        boolean result = linkedList.remove("single");
        // Assert
        assertTrue(result);
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("invalid")
    void removeNonExistentElementFromList() {
        // Arrange
        linkedList.add("first");
        linkedList.add("second");
        // Act
        boolean result = linkedList.remove("nonexistent");
        // Assert
        assertFalse(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("second", linkedList.get(1));
    }
    @Test
    @Tag("boundary")
    void removeElementFromEmptyList() {
        // Arrange
        // List is already empty from setUp
        // Act
        boolean result = linkedList.remove("any");
        // Assert
        assertFalse(result);
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("valid")
    void removeFirstOccurrenceOfDuplicateElement() {
        // Arrange
        linkedList.add("a");
        linkedList.add("b");
        linkedList.add("a");
        linkedList.add("c");
        // Act
        boolean result = linkedList.remove("a");
        // Assert
        assertTrue(result);
        assertEquals(3, linkedList.size());
        assertEquals("b", linkedList.get(0));
        assertEquals("a", linkedList.get(1));
        assertEquals("c", linkedList.get(2));
    }
    @Test
    @Tag("invalid")
    void removeNullElementThrowsException() {
        // Arrange
        linkedList.add("a");
        linkedList.add("b");
        // Act & Assert
        assertThrows(NullPointerException.class, () -> linkedList.remove(null));
        assertEquals(2, linkedList.size());
    }
}