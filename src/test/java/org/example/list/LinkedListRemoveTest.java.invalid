package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import org.junit.jupiter.api.*;

class LinkedListRemoveTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("boundary")
    public void removeSingleElementFromList() {
        // Arrange
        String element = "alpha";
        linkedList.add(element);
        // Act
        boolean result = linkedList.remove(element);
        // Assert
        assertTrue(result, "The remove method should return true for a successful removal.");
        assertEquals(0, linkedList.size(), "The list size should be 0 after removing the only element.");
    }
}