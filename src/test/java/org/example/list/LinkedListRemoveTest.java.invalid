package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.lang.reflect.Field;

class LinkedListRemoveTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    void removeLastElementFromMultiElementList() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        boolean result = linkedList.remove("third");
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("second", linkedList.get(1));
    }
    @Test
    @Tag("boundary")
    void removeElementFromSingleElementList() throws NoSuchFieldException, IllegalAccessException {
        linkedList.add("lonely");
        boolean result = linkedList.remove("lonely");
        assertTrue(result);
        assertEquals(0, linkedList.size());
        Field headField = LinkedList.class.getDeclaredField("head");
        headField.setAccessible(true);
        assertNull(headField.get(linkedList));
    }
    @Test
    @Tag("boundary")
    void removeElementFromEmptyList() {
        boolean result = linkedList.remove("nonexistent");
        assertFalse(result);
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("valid")
    void removeFirstOccurrenceOfDuplicateElement() throws NoSuchFieldException, IllegalAccessException {
        linkedList.add("alpha");
        linkedList.add("beta");
        linkedList.add("alpha");
        linkedList.add("gamma");
        boolean result = linkedList.remove("alpha");
        assertTrue(result);
        assertEquals(3, linkedList.size());
        assertEquals("beta", linkedList.get(0));
        assertEquals("alpha", linkedList.get(1));
        assertEquals("gamma", linkedList.get(2));
        Field headField = LinkedList.class.getDeclaredField("head");
        headField.setAccessible(true);
        Object headNode = headField.get(linkedList);
        assertNotNull(headNode);
        Field dataField = headNode.getClass().getDeclaredField("data");
        dataField.setAccessible(true);
        assertEquals("beta", (String) dataField.get(headNode));
    }
    @Test
    @Tag("invalid")
    void removeNullElementThrowsException() {
        linkedList.add("one");
        linkedList.add("two");
        assertThrows(NullPointerException.class, () -> {
            linkedList.remove(null);
        });
    }
    @Test
    @Tag("invalid")
    void removeElementWithMismatchedCase() {
        linkedList.add("Apple");
        boolean result = linkedList.remove("apple");
        assertFalse(result);
        assertEquals(1, linkedList.size());
        assertEquals("Apple", linkedList.get(0));
    }
    @Test
    @Tag("valid")
    void removeEmptyStringElement() {
        linkedList.add("first");
        linkedList.add("");
        linkedList.add("third");
        boolean result = linkedList.remove("");
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
    }
}