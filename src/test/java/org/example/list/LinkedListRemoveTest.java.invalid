package org.example.list;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListRemoveTest {
    
    private LinkedList linkedList;
    
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    
    @Test
    @Tag("boundary")
    void removeFromEmptyList() {
        assertThrows(NullPointerException.class, () -> linkedList.remove("test"));
    }
    
    @Test
    @Tag("valid")
    void removeSingleElementExists() {
        linkedList.add("single");
        
        boolean result = linkedList.remove("single");
        
        assertTrue(result);
        assertEquals(0, linkedList.size());
    }
    
    @Test
    @Tag("valid")
    void removeSingleElementNotExists() {
        linkedList.add("existing");
        
        boolean result = linkedList.remove("nonexistent");
        
        assertFalse(result);
        assertEquals(1, linkedList.size());
        assertEquals("existing", linkedList.get(0));
    }
    
    @Test
    @Tag("valid")
    void removeFirstElementFromMultipleElements() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        boolean result = linkedList.remove("first");
        
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("second", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void removeMiddleElementFromMultipleElements() {
        linkedList.add("first");
        linkedList.add("middle");
        linkedList.add("last");
        
        boolean result = linkedList.remove("middle");
        
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("last", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void removeLastElementFromMultipleElements() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("last");
        
        boolean result = linkedList.remove("last");
        
        assertTrue(result);
        assertEquals(2, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("second", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void removeNonExistentFromMultipleElements() {
        linkedList.add("element1");
        linkedList.add("element2");
        linkedList.add("element3");
        
        boolean result = linkedList.remove("nonexistent");
        
        assertFalse(result);
        assertEquals(3, linkedList.size());
        assertEquals("element1", linkedList.get(0));
        assertEquals("element2", linkedList.get(1));
        assertEquals("element3", linkedList.get(2));
    }
    
    @Test
    @Tag("invalid")
    void removeNullElement() {
        linkedList.add("test");
        
        assertThrows(NullPointerException.class, () -> linkedList.remove(null));
    }
    
    @Test
    @Tag("valid")
    void removeDuplicateElementsFirstOccurrence() {
        linkedList.add("duplicate");
        linkedList.add("other");
        linkedList.add("duplicate");
        linkedList.add("another");
        
        boolean result = linkedList.remove("duplicate");
        
        assertTrue(result);
        assertEquals(3, linkedList.size());
        assertEquals("other", linkedList.get(0));
        assertEquals("duplicate", linkedList.get(1));
        assertEquals("another", linkedList.get(2));
    }
    
    @Test
    @Tag("valid")
    void removeCaseSensitiveComparison() {
        linkedList.add("Test");
        
        boolean result = linkedList.remove("test");
        
        assertFalse(result);
        assertEquals(1, linkedList.size());
        assertEquals("Test", linkedList.get(0));
    }
}