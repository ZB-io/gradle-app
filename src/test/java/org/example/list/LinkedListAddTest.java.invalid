package org.example.list;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class LinkedListAddTest {
    @Test
    @Tag("valid")
    @DisplayName("Scenario 1: Add a single element to an empty list")
    public void addElementToEmptyList() {
        LinkedList list = new LinkedList();
        list.add("firstElement");
        assertEquals(1, list.size());
        assertEquals("firstElement", list.get(0));
    }
    @Test
    @Tag("valid")
    @DisplayName("Scenario 2: Add an element to a non-empty list")
    public void addElementToNonEmptyList() {
        LinkedList list = new LinkedList();
        list.add("firstElement");
        list.add("secondElement");
        assertEquals(2, list.size());
        assertEquals("firstElement", list.get(0));
        assertEquals("secondElement", list.get(1));
    }
    @Test
    @Tag("boundary")
    @DisplayName("Scenario 3: Add a null element to the list")
    public void addNullElement() {
        LinkedList list = new LinkedList();
        list.add(null);
        assertEquals(1, list.size());
        assertNull(list.get(0));
    }
    @Test
    @Tag("boundary")
    @DisplayName("Scenario 4: Add an empty string element to the list")
    public void addEmptyStringElement() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("");
        assertEquals(2, list.size());
        assertEquals("A", list.get(0));
        assertEquals("", list.get(1));
    }
    @Test
    @Tag("valid")
    @DisplayName("Scenario 5: Add a string element containing only whitespace")
    public void addWhitespaceStringElement() {
        LinkedList list = new LinkedList();
        list.add("   ");
        assertEquals(1, list.size());
        assertEquals("   ", list.get(0));
    }
    @Test
    @Tag("valid")
    @DisplayName("Scenario 6: Add multiple elements sequentially to verify list order and size")
    public void addMultipleElementsAndVerifyOrderAndSize() {
        LinkedList list = new LinkedList();
        list.add("Apple");
        list.add("Banana");
        list.add("Cherry");
        assertEquals(3, list.size());
        assertEquals("Apple", list.get(0));
        assertEquals("Banana", list.get(1));
        assertEquals("Cherry", list.get(2));
    }
    @Test
    @Tag("valid")
    @DisplayName("Scenario 7: Add a duplicate element to the list")
    public void addDuplicateElement() {
        LinkedList list = new LinkedList();
        list.add("duplicate");
        list.add("duplicate");
        assertEquals(2, list.size());
        assertEquals("duplicate", list.get(0));
        assertEquals("duplicate", list.get(1));
    }
}