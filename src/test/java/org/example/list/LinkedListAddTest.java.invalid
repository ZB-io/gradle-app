package org.example.list;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListAddTest {
    
    private LinkedList linkedList;
    
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    
    @Test
    @Tag("valid")
    void addFirstElementToEmptyList() {
        linkedList.add("first");
        
        assertEquals(1, linkedList.size());
        assertEquals("first", linkedList.get(0));
    }
    
    @Test
    @Tag("valid")
    void addMultipleElementsInSequence() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        assertEquals(3, linkedList.size());
        assertEquals("first", linkedList.get(0));
        assertEquals("second", linkedList.get(1));
        assertEquals("third", linkedList.get(2));
    }
    
    @Test
    @Tag("boundary")
    void addNullElement() {
        linkedList.add(null);
        
        assertEquals(1, linkedList.size());
        assertNull(linkedList.get(0));
    }
    
    @Test
    @Tag("boundary")
    void addEmptyStringElement() {
        linkedList.add("");
        
        assertEquals(1, linkedList.size());
        assertEquals("", linkedList.get(0));
    }
    
    @Test
    @Tag("valid")
    void addDuplicateElements() {
        linkedList.add("duplicate");
        linkedList.add("duplicate");
        
        assertEquals(2, linkedList.size());
        assertEquals("duplicate", linkedList.get(0));
        assertEquals("duplicate", linkedList.get(1));
    }
    
    @Test
    @Tag("integration")
    void addElementsAfterRemoval() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.remove("first");
        linkedList.add("third");
        
        assertEquals(2, linkedList.size());
        assertEquals("second", linkedList.get(0));
        assertEquals("third", linkedList.get(1));
    }
    
    @Test
    @Tag("boundary")
    void addSingleCharacterString() {
        linkedList.add("a");
        
        assertEquals(1, linkedList.size());
        assertEquals("a", linkedList.get(0));
    }
    
    @Test
    @Tag("boundary")
    void addVeryLongString() {
        StringBuilder longString = new StringBuilder();
        for (int i = 0; i < 1000; i++) {
            longString.append("a");
        }
        String testString = longString.toString();
        
        linkedList.add(testString);
        
        assertEquals(1, linkedList.size());
        assertEquals(testString, linkedList.get(0));
        assertEquals(1000, linkedList.get(0).length());
    }
    
    @Test
    @Tag("valid")
    void addToListWithSingleElement() {
        linkedList.add("existing");
        linkedList.add("new");
        
        assertEquals(2, linkedList.size());
        assertEquals("existing", linkedList.get(0));
        assertEquals("new", linkedList.get(1));
    }
    
    @Test
    @Tag("boundary")
    void addSpecialCharactersAndUnicode() {
        linkedList.add("!@#$%");
        linkedList.add("café");
        linkedList.add("🎉");
        
        assertEquals(3, linkedList.size());
        assertEquals("!@#$%", linkedList.get(0));
        assertEquals("café", linkedList.get(1));
        assertEquals("🎉", linkedList.get(2));
    }
    
    @Test
    @Tag("valid")
    void addWhitespaceOnlyString() {
        linkedList.add("   ");
        linkedList.add("\t\n");
        
        assertEquals(2, linkedList.size());
        assertEquals("   ", linkedList.get(0));
        assertEquals("\t\n", linkedList.get(1));
    }
    
    @Test
    @Tag("valid")
    void addNumericStringValues() {
        linkedList.add("123");
        linkedList.add("0");
        linkedList.add("-456");
        
        assertEquals(3, linkedList.size());
        assertEquals("123", linkedList.get(0));
        assertEquals("0", linkedList.get(1));
        assertEquals("-456", linkedList.get(2));
    }
    
    @Test
    @Tag("integration")
    void addAfterCompleteListClear() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        linkedList.remove("first");
        linkedList.remove("second");
        linkedList.remove("third");
        
        linkedList.add("newFirst");
        
        assertEquals(1, linkedList.size());
        assertEquals("newFirst", linkedList.get(0));
    }
    
    @Test
    @Tag("valid")
    void addMixedNullAndValidElements() {
        linkedList.add("valid");
        linkedList.add(null);
        linkedList.add("another");
        
        assertEquals(3, linkedList.size());
        assertEquals("valid", linkedList.get(0));
        assertNull(linkedList.get(1));
        assertEquals("another", linkedList.get(2));
    }
    
    @Test
    @Tag("boundary")
    void addStringWithEscapeCharacters() {
        linkedList.add("line1\nline2");
        linkedList.add("tab\there");
        linkedList.add("quote\"inside");
        
        assertEquals(3, linkedList.size());
        assertEquals("line1\nline2", linkedList.get(0));
        assertEquals("tab\there", linkedList.get(1));
        assertEquals("quote\"inside", linkedList.get(2));
    }
}