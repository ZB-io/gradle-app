package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;

class LinkedListAddTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void addNullElement() {
        linkedList.add(null);
        assertEquals(1, linkedList.size());
        assertNull(linkedList.get(0));
    }
    @Test
    @Tag("valid")
    public void addEmptyStringElement() {
        String element = "";
        linkedList.add(element);
        assertEquals(1, linkedList.size());
        assertEquals(element, linkedList.get(0));
    }
    @Test
    @Tag("boundary")
    public void addElementAfterListBecomesEmpty() {
        linkedList.add("first");
        linkedList.remove("first");
        String newElement = "second";
        linkedList.add(newElement);
        assertEquals(1, linkedList.size());
        assertEquals(newElement, linkedList.get(0));
    }
    @Test
    @Tag("valid")
    public void addWhitespaceStringElement() {
        String whitespaceElement = "   ";
        linkedList.add(whitespaceElement);
        assertEquals(1, linkedList.size());
        assertEquals(whitespaceElement, linkedList.get(0));
    }
}