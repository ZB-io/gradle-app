package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;

class LinkedListAddTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void addElementToEmptyList() {
        linkedList.add("FirstElement");
        assertEquals(1, linkedList.size(), "Size should be 1 after adding an element to an empty list");
        assertEquals("FirstElement", linkedList.get(0), "The head element should be the one added");
    }
    @Test
    @Tag("valid")
    public void addMultipleElementsSequentially() {
        linkedList.add("FirstElement");
        linkedList.add("SecondElement");
        linkedList.add("ThirdElement");
        assertEquals(3, linkedList.size(), "Size should match the number of added elements");
        assertEquals("FirstElement", linkedList.get(0), "First element should be 'FirstElement'");
        assertEquals("SecondElement", linkedList.get(1), "Second element should be 'SecondElement'");
        assertEquals("ThirdElement", linkedList.get(2), "Third element should be 'ThirdElement'");
    }
    @Test
    @Tag("valid")
    public void addNullElement() {
        linkedList.add(null);
        assertEquals(1, linkedList.size(), "Size should increase by one when adding a null element");
        assertNull(linkedList.get(0), "The element should be null");
    }
    @Test
    @Tag("valid")
    public void addElementToNonEmptyList() {
        linkedList.add("FirstElement");
        linkedList.add("SecondElement");
        linkedList.add("NewElement");
        assertEquals(3, linkedList.size(), "Size should increase when adding an element to a non-empty list");
        assertEquals("NewElement", linkedList.get(2), "The new element should be at the end");
    }
    @Test
    @Tag("valid")
    public void addDuplicateElements() {
        linkedList.add("DuplicateElement");
        linkedList.add("DuplicateElement");
        assertEquals(2, linkedList.size(), "Size should reflect the number of additions");
        assertEquals("DuplicateElement", linkedList.get(0), "First element should be 'DuplicateElement'");
        assertEquals("DuplicateElement", linkedList.get(1), "Second element should be 'DuplicateElement'");
    }
}