package org.example.list;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;

public class LinkedListAddTest {
    private LinkedList setupLinkedList() {
        return new LinkedList(); // Setup the LinkedList to be used in tests
    }
    @Test
    @Tag("valid")
    public void addToEmptyList() {
        // Arrange
        LinkedList list = setupLinkedList();
        // Act
        list.add("first"); // The add method should handle insertion of the first node
        // Assert
        assertEquals(1, list.size(), "Size should be 1 after adding one element");
        assertEquals((String) "first", (String) list.get(0), "The first element should be 'first'");
    }
    @Test
    @Tag("valid")
    public void addMultipleElements() {
        // Arrange
        LinkedList list = setupLinkedList();
        // Act
        list.add("a");
        list.add("b");
        list.add("c");
        // Assert
        assertEquals(3, list.size(), "Size should be 3 after adding three elements");
        assertEquals((String) "a", (String) list.get(0), "The first element should be 'a'");
        assertEquals((String) "b", (String) list.get(1), "The second element should be 'b'");
        assertEquals((String) "c", (String) list.get(2), "The third element should be 'c'");
    }
    @Test
    @Tag("valid")
    public void addNullElement() {
        // Adding a null element should ensure no NullPointerException occurs
        // Arrange
        LinkedList list = setupLinkedList();
        // Act
        list.add(null);
        // Assert
        assertEquals(1, list.size(), "Size should be 1 after adding one null element");
        assertNull(list.get(0), "The first element should be null");
    }
    @Test
    @Tag("valid")
    public void addPreservesExistingNodes() {
        // Arrange
        LinkedList list = setupLinkedList();
        list.add("alpha");
        list.add("beta");
        // Act
        list.add("gamma"); // New element 'gamma' should be added after 'beta'
        // Assert
        assertEquals(3, list.size(), "Size should be 3 after adding a new element");
        assertEquals((String) "alpha", (String) list.get(0), "First element should be 'alpha'");
        assertEquals((String) "beta", (String) list.get(1), "Second element should be 'beta'");
        assertEquals((String) "gamma", (String) list.get(2), "Third element should be 'gamma'");
    }
    @Test
    @Tag("boundary")
    public void addDuplicateElement() {
        // Adding duplicate elements should not cause unexpected behavior
        // Arrange
        LinkedList list = setupLinkedList();
        list.add("duplicate");
        // Act
        list.add("duplicate"); // Adding duplicate value
        // Assert
        assertEquals(2, list.size(), "Size should be 2 after adding a duplicate element");
        assertEquals((String) "duplicate", (String) list.get(0), "First element should be 'duplicate'");
        assertEquals((String) "duplicate", (String) list.get(1), "Second element should also be 'duplicate'");
    }
    @Test
    @Tag("integration")
    public void addToNonEmptyList() {
        // Arrange
        LinkedList list = setupLinkedList();
        list.add("x");
        list.add("y");
        list.add("z");
        // Act
        list.add("w"); // Adding 'w' should work without replacing existing nodes
        // Assert
        assertEquals(4, list.size(), "Size should be 4 after adding a new element");
        assertEquals((String) "x", (String) list.get(0), "First element should be 'x'");
        assertEquals((String) "y", (String) list.get(1), "Second element should be 'y'");
        assertEquals((String) "z", (String) list.get(2), "Third element should be 'z'");
        assertEquals((String) "w", (String) list.get(3), "Fourth element should be 'w'");
    }
    @Test
    @Tag("integration")
    public void addAfterDeletions() {
        // Arrange
        LinkedList list = setupLinkedList();
        list.add("cat");
        list.add("dog");
        list.add("mouse");
        list.remove("dog");
        // Enhancement required: The `remove` method in the business logic should handle node removals correctly
        // Act
        list.add("rabbit");
        // Assert
        assertEquals(3, list.size(), "Size should be 3 after adding an element post deletion");
        assertEquals((String) "cat", (String) list.get(0), "First element should be 'cat'");
        assertEquals((String) "mouse", (String) list.get(1), "Second element should be 'mouse'");
        assertEquals((String) "rabbit", (String) list.get(2), "Third element should be 'rabbit'");
    }
    @Test
    @Tag("boundary")
    public void validateTailLogicWhenAdding() {
        // Arrange
        LinkedList list = setupLinkedList();
        list.add("start");
        list.add("middle");
        // Act
        list.add("end"); // Adding to the tail should ensure updates are correct
        // Assert
        assertEquals(3, list.size(), "Size should be 3 after adding a new element");
        assertEquals((String) "start", (String) list.get(0), "First element should be 'start'");
        assertEquals((String) "middle", (String) list.get(1), "Second element should be 'middle'");
        assertEquals((String) "end", (String) list.get(2), "Third element should be 'end'");
    }
}