package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class LinkedListSizeTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("boundary")
    public void testSizeOfEmptyList() {
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeOfListWithOneElement() {
        linkedList.add("First");
        assertEquals(1, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void testSizeOfListWithMultipleElements() {
        linkedList.add("First");
        linkedList.add("Second");
        linkedList.add("Third");
        assertEquals(3, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void testSizeAfterRemovingElementFromMiddle() {
        linkedList.add("First");
        linkedList.add("Second");
        linkedList.add("Third");
        linkedList.remove("Second");
        assertEquals(2, linkedList.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeAfterRemovingHeadElement() {
        linkedList.add("First");
        linkedList.add("Second");
        linkedList.remove("First");
        assertEquals(1, linkedList.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeAfterRemovingTailElement() {
        linkedList.add("First");
        linkedList.add("Second");
        linkedList.remove("Second");
        assertEquals(1, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void testSizeAfterAttemptingToRemoveNonExistentElement() {
        linkedList.add("First");
        linkedList.add("Second");
        linkedList.remove("Third");
        assertEquals(2, linkedList.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeAfterRemovingLastElement() {
        linkedList.add("OnlyOne");
        linkedList.remove("OnlyOne");
        assertEquals(0, linkedList.size());
    }
}