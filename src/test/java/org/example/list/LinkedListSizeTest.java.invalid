package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

class LinkedListSizeTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void sizeOfEmptyListIsZero() {
        int actualSize = linkedList.size();
        assertEquals(0, actualSize);
    }
    @Test
    @Tag("valid")
    public void sizeIsOneForListWithSingleElement() {
        linkedList.add("element1");
        int actualSize = linkedList.size();
        assertEquals(1, actualSize);
    }
    @Test
    @Tag("valid")
    public void sizeReflectsCorrectCountAfterAddingMultipleElements() {
        linkedList.add("element1");
        linkedList.add("element2");
        linkedList.add("element3");
        int actualSize = linkedList.size();
        assertEquals(3, actualSize);
    }
    @Test
    @Tag("valid")
    public void sizeDecrementsAfterRemovingAnElement() {
        linkedList.add("apple");
        linkedList.add("banana");
        linkedList.remove("apple");
        int actualSize = linkedList.size();
        assertEquals(1, actualSize);
    }
    @Test
    @Tag("boundary")
    public void sizeIsZeroAfterRemovingAllElements() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.remove("first");
        linkedList.remove("second");
        int actualSize = linkedList.size();
        assertEquals(0, actualSize);
    }
    @Test
    @Tag("invalid")
    public void sizeRemainsUnchangedAfterAttemptingToRemoveNonExistentElement() {
        linkedList.add("one");
        linkedList.add("two");
        linkedList.remove("three");
        int actualSize = linkedList.size();
        assertEquals(2, actualSize);
    }
}