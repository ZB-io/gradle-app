package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

class LinkedListSizeTest {
    @Test
    @Tag("valid")
    public void sizeAfterAddingDuplicateElements() {
        // Arrange
        LinkedList list = new LinkedList();
        // TODO: The user can change the duplicate element and the number of times it's added.
        String duplicateElement = "duplicate";
        list.add(duplicateElement);
        list.add(duplicateElement);
        list.add(duplicateElement);
        // Act
        int result = list.size();
        // Assert
        assertEquals(3, result);
    }
