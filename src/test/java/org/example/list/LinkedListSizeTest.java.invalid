package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class LinkedListSizeTest {
    // Scenario 1: Verifying size after initializing an empty LinkedList.
    @Test
    @Tag("valid")
    public void sizeOfEmptyList() {
        // Arrange
        LinkedList list = new LinkedList();
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 0, (int) actualSize, "Size of an empty LinkedList should be 0");
    }
    // Scenario 2: Verifying the size after adding one element.
    @Test
    @Tag("valid")
    public void sizeAfterAddingOneElement() {
        // Arrange
        LinkedList list = new LinkedList();
        list.add("Element1"); 
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 1, (int) actualSize, "Size of LinkedList should be 1 after adding one element");
    }
    // Scenario 3: Verifying the size after adding multiple elements.
    @Test
    @Tag("valid")
    public void sizeAfterAddingMultipleElements() {
        // Arrange
        LinkedList list = new LinkedList();
        list.add("Element1"); 
        list.add("Element2"); 
        list.add("Element3"); 
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 3, (int) actualSize, "Size of LinkedList should be 3 after adding three elements");
    }
    // Scenario 4: Verifying the size after removing an element.
    @Test
    @Tag("valid")
    public void sizeAfterRemovingOneElement() {
        // Arrange
        LinkedList list = new LinkedList();
        list.add("Element1"); 
        list.add("Element2"); 
        list.add("Element3"); 
        boolean elementExists = list.remove("Element2"); // Check returned value to ensure logic is intact
        if (!elementExists) {
            throw new AssertionError("Business logic error: Element not found for deletion.");
        }
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 2, (int) actualSize, "Size of LinkedList should be 2 after removing one element");
    }
    // Scenario 5: Verifying the size when all elements are removed.
    @Test
    @Tag("valid")
    public void sizeAfterRemovingAllElements() {
        // Arrange
        LinkedList list = new LinkedList();
        list.add("Element1"); 
        list.add("Element2"); 
        boolean elementRemoved1 = list.remove("Element1");
        boolean elementRemoved2 = list.remove("Element2");
        if (!elementRemoved1 || !elementRemoved2) {
            throw new AssertionError("Business logic error: Element(s) not found for deletion.");
        }
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 0, (int) actualSize, "Size of LinkedList should be 0 after removing all elements");
    }
    // Scenario 6: Verifying the size when an element is removed from an empty list.
    @Test
    @Tag("boundary")
    public void sizeWhenRemovingFromAnEmptyList() {
        // Arrange
        LinkedList list = new LinkedList();
        boolean elementExists = list.remove("NonExistentElement");
        if (elementExists) {
            throw new AssertionError("Business logic error: Element removal should return false when no elements exist.");
        }
        // Act
        int actualSize = list.size();
        // Assert
        assertEquals((int) 0, (int) actualSize, "Size of LinkedList should remain 0 when trying to remove from an empty list");
    }
