package org.example.list;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

class LinkedListSizeTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void sizeOfListAfterRemovingOnlyElement() {
        linkedList.add("A");
        linkedList.remove("A");
        assertEquals(0, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeAfterRemovingHeadElementFromMultiElementList() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("C");
        linkedList.remove("A");
        assertEquals(2, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeAfterRemovingMiddleElementFromMultiElementList() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("C");
        linkedList.remove("B");
        assertEquals(2, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeAfterRemovingTailElementFromMultiElementList() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("C");
        linkedList.remove("C");
        assertEquals(2, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeAfterMultipleAddAndRemoveOperations() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("C");
        linkedList.add("D");
        linkedList.add("E");
        linkedList.remove("A");
        linkedList.remove("D");
        linkedList.add("F");
        assertEquals(4, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeOfListWithDuplicateElements() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("A");
        linkedList.add("C");
        linkedList.add("B");
        assertEquals(5, linkedList.size());
    }
    @Test
    @Tag("valid")
    public void sizeAfterRemovingOneInstanceOfDuplicateElement() {
        linkedList.add("A");
        linkedList.add("B");
        linkedList.add("A");
        linkedList.remove("A");
        assertEquals(2, linkedList.size());
    }
}