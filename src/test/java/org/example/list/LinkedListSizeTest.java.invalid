package org.example.list;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class LinkedListSizeTest {
    @Test
    @Tag("valid")
    public void sizeOfEmptyList() {
        LinkedList list = new LinkedList();
        assertEquals(0, (int) list.size());
    }
    
    @Test
    @Tag("valid")
    public void sizeAfterAddingMultipleElements() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.add("three");
        assertEquals(3, (int) list.size());
    }
    
    @Test
    @Tag("valid")
    public void sizeAfterRemovingElement() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.remove("one");
        assertEquals(1, (int) list.size());
    }
    
    @Test
    @Tag("valid")
    public void sizeAfterRemovingAllElements() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.remove("one");
        list.remove("two");
        assertEquals(0, (int) list.size());
    }
    
    @Test
    @Tag("valid")
    public void sizeWithDuplicateElements() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("one");
        list.add("two");
        assertEquals(3, (int) list.size());
    }
    
    @Test
    @Tag("valid")
    public void sizeAfterRemovingNonExistentElement() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.remove("three"); // Attempt to remove a non-existent element
        assertEquals(2, (int) list.size());
    }
}