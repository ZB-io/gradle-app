package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

class LinkedListGetTest {
    private LinkedList linkedList;
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void getFirstElementFromMultiElementList() {
        // Arrange
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        // Act
        String result = linkedList.get(0);
        // Assert
        assertEquals("Apple", result);
    }
    @Test
    @Tag("valid")
    public void getMiddleElementFromList() {
        // Arrange
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        // Act
        String result = linkedList.get(1);
        // Assert
        assertEquals("Banana", result);
    }
    @Test
    @Tag("boundary")
    public void getLastElementFromList() {
        // Arrange
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        // Act
        String result = linkedList.get(2);
        // Assert
        assertEquals("Cherry", result);
    }
    @Test
    @Tag("boundary")
    public void getElementFromSingleElementList() {
        // Arrange
        linkedList.add("Apple");
        // Act
        String result = linkedList.get(0);
        // Assert
        assertEquals("Apple", result);
    }
    @Test
    @Tag("boundary")
    @Tag("invalid")
    public void getElementWithIndexEqualToSizeThrowsException() {
        // Arrange
        linkedList.add("Apple");
        linkedList.add("Banana");
        // Act & Assert
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(2);
        });
    }
    @Test
    @Tag("invalid")
    public void getElementWithIndexGreaterThanSizeThrowsException() {
        // Arrange
        linkedList.add("Apple");
        // Act & Assert
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(10);
        });
    }
    @Test
    @Tag("boundary")
    @Tag("invalid")
    public void getElementFromEmptyListThrowsException() {
        // Arrange
        // LinkedList is empty by default from setUp
        // Act & Assert
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(0);
        });
    }
    @Test
    @Tag("invalid")
    public void getElementWithNegativeIndexThrowsException() {
        // Arrange
        linkedList.add("Apple");
        linkedList.add("Banana");
        // Act & Assert
        // Note: The current implementation has a bug and would not throw for a negative index.
        // This test is written for the expected correct behavior. A check for index < 0 should be added to the get method.
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-1);
        });
    }
}