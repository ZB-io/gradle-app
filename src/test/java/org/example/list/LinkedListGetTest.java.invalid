package org.example.list;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListGetTest {
    
    private LinkedList linkedList;
    
    @BeforeEach
    void setUp() {
        linkedList = new LinkedList();
    }
    
    @Test
    @Tag("valid")
    void getElementAtValidIndex() {
        linkedList.add("first");
        linkedList.add("second");
        linkedList.add("third");
        
        String result = linkedList.get(1);
        
        assertEquals("second", result);
    }
    
    @Test
    @Tag("boundary")
    void getFirstElementAtIndexZero() {
        linkedList.add("head");
        
        String result = linkedList.get(0);
        
        assertEquals("head", result);
    }
    
    @Test
    @Tag("boundary")
    void getLastElementInList() {
        linkedList.add("alpha");
        linkedList.add("beta");
        linkedList.add("gamma");
        linkedList.add("delta");
        
        String result = linkedList.get(3);
        
        assertEquals("delta", result);
    }
    
    @Test
    @Tag("invalid")
    void throwExceptionForNegativeIndex() {
        linkedList.add("element");
        
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-1);
        });
    }
    
    @Test
    @Tag("invalid")
    void throwExceptionForIndexBeyondSize() {
        linkedList.add("item1");
        linkedList.add("item2");
        
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(5);
        });
    }
    
    @Test
    @Tag("boundary")
    void throwExceptionOnEmptyList() {
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(0);
        });
    }
    
    @Test
    @Tag("boundary")
    void getSingleElementFromSingleItemList() {
        linkedList.add("solo");
        
        String result = linkedList.get(0);
        
        assertEquals("solo", result);
    }
    
    @Test
    @Tag("edge")
    void throwExceptionForIndexEqualToSize() {
        linkedList.add("first");
        linkedList.add("second");
        
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(2);
        });
    }
    
    @Test
    @Tag("edge")
    void throwExceptionForLargeNegativeIndex() {
        linkedList.add("element");
        
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-100);
        });
    }
}