package org.example.list;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class LinkedListGetTest {
    @Test
    @Tag("valid")
    public void getElementFromValidIndex() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        String actual = (String) linkedList.get(1);
        String expected = "Element2";
        assertEquals(expected, actual);
    }
    @Test
    @Tag("invalid")
    public void handleNegativeIndexError() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        assertThrows(IndexOutOfBoundsException.class, () -> linkedList.get(-1));
    }
    @Test
    @Tag("invalid")
    public void handleIndexGreaterThanSizeError() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        int invalidIndex = linkedList.size() + 1; // Adjusted logic based on existing field definition
        assertThrows(IndexOutOfBoundsException.class, () -> linkedList.get(invalidIndex));
    }
    @Test
    @Tag("boundary")
    public void getElementFromEmptyList() {
        LinkedList linkedList = new LinkedList();
        assertThrows(IndexOutOfBoundsException.class, () -> linkedList.get(0));
    }
    @Test
    @Tag("boundary")
    public void getFirstElementSingleElementList() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("SingleElement");
        String actual = (String) linkedList.get(0);
        String expected = "SingleElement";
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void getElementFromMiddleIndex() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        linkedList.add("Element4");
        linkedList.add("Element5");
        String actual = (String) linkedList.get(2); // Middle index
        String expected = "Element3";
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void getLastElement() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        linkedList.add("Element4");
        int lastIndex = 3; // Adjust lastIndex value explicitly
        String actual = (String) linkedList.get(lastIndex);
        String expected = "Element4";
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void getMultipleConsecutiveElements() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        assertEquals("Element1", (String) linkedList.get(0));
        assertEquals("Element2", (String) linkedList.get(1));
        assertEquals("Element3", (String) linkedList.get(2));
    }
    @Test
    @Tag("valid")
    public void getElementDuplicateValues() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("DuplicateElement");
        linkedList.add("Element2");
        linkedList.add("DuplicateElement");
        String actual = (String) linkedList.get(2);
        String expected = "DuplicateElement";
        assertEquals(expected, actual);
        actual = (String) linkedList.get(0);
        assertEquals(expected, actual);
    }
    @Test
    @Tag("integration")
    public void getElementAfterRemove() {
        LinkedList linkedList = new LinkedList();
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        boolean isRemoved = linkedList.remove("Element2"); // Verifying the proper functionality of remove
        assertTrue(isRemoved);
        String actual = (String) linkedList.get(1); // Index has shifted after removal
        String expected = "Element3";
        assertEquals(expected, actual);
    }
}