package org.example.list;import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;

class LinkedListGetTest {
    private LinkedList list;
    @BeforeEach
    void setUp() {
        list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
    }
    @Test
    @DisplayName("Test get method with valid index within the list range")
    @Tag("valid")
    void testGetWithValidIndex() {
        String expected = "B";
        String actual = list.get(1);
        assertEquals(expected, actual);
    }
    @Test
    @DisplayName("Test get method with index equal to the list size")
    @Tag("boundary")
    void testGetWithIndexEqualToListSize() {
        String expected = "C";
        String actual = list.get(list.size() - 1);
        assertEquals(expected, actual);
    }
    @Test
    @DisplayName("Test get method with index less than zero")
    @Tag("invalid")
    void testGetWithIndexLessThanZero() {
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(-1));
    }
    @Test
    @DisplayName("Test get method with index greater than the list size")
    @Tag("invalid")
    void testGetWithIndexGreaterThanListSize() {
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(list.size()));
    }
    @Test
    @DisplayName("Test get method with an empty list")
    @Tag("invalid")
    void testGetWithEmptyList() {
        list = new LinkedList();
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(0));
    }
}
class Node {
    String data;
    Node next;
}
class LinkedList {
    private Node head;
    private int size;
    public void add(String data) {
        if (head == null) {
            head = new Node();
            head.data = data;
            size++;
            return;
        }
        Node it = head;
        while (it.next != null) {
            it = it.next;
        }
        Node newNode = new Node();
        newNode.data = data;
        it.next = newNode;
        size++;
    }
    public int size() {
        return size;
    }
    public String get(int index) {
        Node it = head;
        for (int i = 0; i < index; i++) {
            if (it.next == null) {
                throw new IndexOutOfBoundsException("Index is out of range");
            }
            it = it.next;
        }
        return it.data;
    }
}