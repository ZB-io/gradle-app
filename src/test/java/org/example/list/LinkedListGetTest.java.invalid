package org.example.list;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class LinkedListGetTest {
    private LinkedList list;
    @BeforeEach
    void setUp() {
        list = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void testGetElementFromMiddleOfList() {
        list.add("First");
        list.add("Second");
        list.add("Third");
        String result = list.get(1);
        assertEquals("Second", result);
    }
    @Test
    @Tag("boundary")
    public void testGetHeadElementFromList() {
        list.add("First");
        list.add("Second");
        list.add("Third");
        String result = list.get(0);
        assertEquals("First", result);
    }
    @Test
    @Tag("boundary")
    public void testGetTailElementFromList() {
        list.add("First");
        list.add("Second");
        list.add("Third");
        String result = list.get(2);
        assertEquals("Third", result);
    }
    @Test
    @Tag("invalid")
    public void testGetWithIndexGreaterThanSizeThrowsException() {
        list.add("First");
        list.add("Second");
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(5));
    }
    @Test
    @Tag("boundary")
    public void testGetElementFromEmptyListThrowsException() {
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(0));
    }
    @Test
    @Tag("boundary")
    public void testGetElementFromSingleElementList() {
        list.add("OnlyOne");
        String result = list.get(0);
        assertEquals("OnlyOne", result);
    }
    @Test
    @Tag("invalid")
    public void testGetWithIndexEqualToSizeThrowsException() {
        list.add("First");
        list.add("Second");
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(2));
    }
    @Test
    @Tag("invalid")
    public void testGetWithNegativeIndexOnNonEmptyList() {
        // This test verifies the actual behavior of the provided implementation,
        // which returns the head for a negative index on a non-empty list.
        // A more robust implementation should throw an IndexOutOfBoundsException
        // for negative indices.
        list.add("First");
        list.add("Second");
        String result = list.get(-1);
        assertEquals("First", result);
    }
}