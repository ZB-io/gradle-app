package org.example.list;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Assertions;

public class LinkedListGetTest {
    private LinkedList linkedList;
    @BeforeEach
    public void setUp() {
        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    public void getElementAtValidIndex() {
        linkedList.add("Element1");
        linkedList.add("Element2");
        linkedList.add("Element3");
        String result = linkedList.get(1);
        Assertions.assertEquals("Element2", (String) result);
    }
    @Test
    @Tag("invalid")
    public void getElementFromEmptyList() {
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(0);
        });
    }
    @Test
    @Tag("boundary")
    public void getFirstElement() {
        linkedList.add("FirstElement");
        linkedList.add("SecondElement");
        String result = linkedList.get(0);
        Assertions.assertEquals("FirstElement", (String) result);
    }
    @Test
    @Tag("boundary")
    public void getLastElement() {
        linkedList.add("FirstElement");
        linkedList.add("SecondElement");
        linkedList.add("LastElement");
        String result = linkedList.get(2); // Directly using the index instead of size() - 1
        Assertions.assertEquals("LastElement", (String) result);
    }
    @Test
    @Tag("invalid")
    public void getElementWithNegativeIndex() {
        linkedList.add("Element1");
        linkedList.add("Element2");
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(-1);
        });
    }
    @Test
    @Tag("invalid")
    public void getElementWithIndexGreaterThanSize() {
        linkedList.add("Element1");
        linkedList.add("Element2");
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(3); // Using a fixed index greater than the list size
        });
    }
}