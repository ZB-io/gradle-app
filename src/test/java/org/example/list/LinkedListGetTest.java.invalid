        linkedList = new LinkedList();
    }
    @Test
    @Tag("valid")
    void getFirstElementFromMultiElementList() {
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        String result = linkedList.get(0);
        assertEquals("Apple", result);
    }
    @Test
    @Tag("valid")
    void getMiddleElementFromList() {
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        String result = linkedList.get(1);
        assertEquals("Banana", result);
    }
    @Test
    @Tag("boundary")
    void getLastElementFromList() {
        linkedList.add("Apple");
        linkedList.add("Banana");
        linkedList.add("Cherry");
        String result = linkedList.get(2);
        assertEquals("Cherry", result);
    }
    @Test
    @Tag("boundary")
    void getElementFromSingleElementList() {
        linkedList.add("Apple");
        String result = linkedList.get(0);
        assertEquals("Apple", result);
    }
    @Test
    @Tag("invalid")
    void getThrowsExceptionOnEmptyList() {
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(0);
        });
    }
    @Test
    @Tag("boundary")
    void getThrowsExceptionForIndexEqualToSize() {
        linkedList.add("Apple");
        linkedList.add("Banana");
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(2);
        });
    }
    @Test
    @Tag("invalid")
    void getThrowsExceptionForIndexGreaterThanSize() {
        linkedList.add("Apple");
        linkedList.add("Banana");
        assertThrows(IndexOutOfBoundsException.class, () -> {
            linkedList.get(10);
        });
    }
    @Test
    @Tag("boundary")
    void getReturnsFirstElementForNegativeIndex() {
        // SUGGESTION: The business logic for get(int index) is flawed.
        // For a negative index, it currently returns the head element instead of throwing an IndexOutOfBoundsException.
        // The logic should be enhanced to check for index < 0 and throw an exception.
        linkedList.add("Apple");
        linkedList.add("Banana");
        String result = linkedList.get(-1);
        assertEquals("Apple", result);
