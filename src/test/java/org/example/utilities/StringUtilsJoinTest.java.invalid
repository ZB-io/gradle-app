package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void joinWithEmptyLinkedList() {
        // Arrange
        LinkedList emptyList = new LinkedList(); // Assuming LinkedList has a default no-args constructor
        // Act
        String result = StringUtils.join(emptyList);
        // Assert
        assertEquals((String) "", result, "join method should return an empty string for an empty LinkedList.");
    }
    @Test
    @Tag("valid")
    public void joinWithSingleElementLinkedList() {
        // Arrange
        LinkedList singleElementList = new LinkedList();
        singleElementList.head = new Node("A", null); // Correctly set the `head` field using Node
        // Act
        String result = StringUtils.join(singleElementList);
        // Assert
        assertEquals((String) "A", result, "join method should return the single element as a string for a LinkedList with one element.");
    }
    @Test
    @Tag("valid")
    public void joinWithMultipleElementLinkedList() {
        // Arrange
        LinkedList multipleElementList = new LinkedList();
        Node secondNode = new Node("B", null);
        Node firstNode = new Node("A", secondNode);
        multipleElementList.head = firstNode; // Correctly set the starting Node for LinkedList
        secondNode.next = new Node("C", null); // Add the final Node
        // Act
        String result = StringUtils.join(multipleElementList);
        // Assert
        assertEquals((String) "A,B,C", result, "join method should return a comma-separated string containing all elements of the LinkedList.");
    }
    @Test
    @Tag("boundary")
    public void joinWithNullLinkedList() {
        // Arrange
        LinkedList nullLinkedList = null;
        // Act
        String result = StringUtils.join(nullLinkedList);
        // Assert
        assertEquals((String) null, result, "join method should return null when the input LinkedList is null."); // Assuming the method returns null
    }
    @Test
    @Tag("valid")
    public void joinWithSpecialCharactersInLinkedList() {
        // Arrange
        LinkedList specialCharList = new LinkedList();
        Node firstNode = new Node("Hello", null);
        specialCharList.head = firstNode; // Correctly set up the head node
        firstNode.next = new Node("World!", null); // Setting next nodes
        firstNode.next.next = new Node("@#$%^", null);
        // Act
        String result = StringUtils.join(specialCharList);
        // Assert
        assertEquals((String) "Hello,World!,@#$%^", result, "join method should return a string with special characters correctly joined by commas.");
    }
