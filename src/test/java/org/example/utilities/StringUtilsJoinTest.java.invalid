package org.example.utilities;
import org.example.StringUtils;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void joinWithMultipleStringElements() {
        LinkedList<String> source = new LinkedList<>();
        source.add("apple");
        source.add("banana");
        source.add("cherry");
        String result = StringUtils.join(source);
        assertEquals("apple,banana,cherry", result);
    }
    @Test
    @Tag("boundary")
    public void joinWithSingleElement() {
        LinkedList<String> source = new LinkedList<>();
        source.add("apple");
        String result = StringUtils.join(source);
        assertEquals("apple", result);
    }
    @Test
    @Tag("boundary")
    public void joinWithEmptyList() {
        LinkedList<String> source = new LinkedList<>();
        String result = StringUtils.join(source);
        assertEquals("", result);
    }
    @Test
    @Tag("valid")
    public void joinWithNullElementInList() {
        LinkedList<String> source = new LinkedList<>();
        source.add("apple");
        source.add(null);
        source.add("cherry");
        String result = StringUtils.join(source);
        assertEquals("apple,null,cherry", result);
    }
    @Test
    @Tag("valid")
    public void joinWithEmptyStringElementInList() {
        LinkedList<String> source = new LinkedList<>();
        source.add("apple");
        source.add("");
        source.add("cherry");
        String result = StringUtils.join(source);
        assertEquals("apple,,cherry", result);
    }
    @Test
    @Tag("valid")
    public void joinWithWhitespaceElements() {
        LinkedList<String> source = new LinkedList<>();
        source.add("  apple  ");
        source.add("banana");
        source.add(" cherry ");
        String result = StringUtils.join(source);
        assertEquals("  apple  ,banana, cherry ", result);
    }
    @Test
    @Tag("invalid")
    public void joinWithNullList() {
        LinkedList<String> source = null;
        assertThrows(NullPointerException.class, () -> {
            StringUtils.join(source);
        });
    }
    @Test
    @Tag("boundary")
    public void joinWithOnlyNullElements() {
        LinkedList<String> source = new LinkedList<>();
        source.add(null);
        source.add(null);
        String result = StringUtils.join(source);
        assertEquals("null,null", result);
    }
}