package org.example.utilities;import org.example.list.LinkedList;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void joinEmptyList() {
        LinkedList emptyList = mock(LinkedList.class);
        when(emptyList.head).thenReturn(null); // Assuming head is null for empty list
        String result = StringUtils.join(emptyList);
        assertEquals("", result);
    }
    @Test
    @Tag("valid")
    public void joinSingleElementList() {
        LinkedList singleElementList = mock(LinkedList.class);
        when(singleElementList.head).thenReturn(new Node("Hello")); // Assuming Node class exists
        String result = StringUtils.join(singleElementList);
        assertEquals("Hello", result);
    }
    @Test
    @Tag("valid")
    public void joinMultipleElementsList() {
        LinkedList multipleElementsList = mock(LinkedList.class);
        Node node1 = new Node("Hello");
        Node node2 = new Node("World");
        Node node3 = new Node("!");
        node1.next = node2;
        node2.next = node3;
        when(multipleElementsList.head).thenReturn(node1);
        String result = StringUtils.join(multipleElementsList);
        assertEquals("Hello,World,!", result);
    }
    @Test
    @Tag("valid")
    public void joinListWithNullElements() {
        LinkedList listWithNulls = mock(LinkedList.class);
        Node node1 = new Node("Hello");
        Node node2 = new Node(null);
        Node node3 = new Node("World");
        node1.next = node2;
        node2.next = node3;
        when(listWithNulls.head).thenReturn(node1);
        String result = StringUtils.join(listWithNulls);
        assertEquals("Hello,,World", result);
    }
    @Test
    @Tag("valid")
    public void joinListWithSpecialCharacters() {
        LinkedList specialCharactersList = mock(LinkedList.class);
        Node node1 = new Node("Hello");
        Node node2 = new Node("World!");
        Node node3 = new Node("@2023");
        node1.next = node2;
        node2.next = node3;
        when(specialCharactersList.head).thenReturn(node1);
        String result = StringUtils.join(specialCharactersList);
        assertEquals("Hello,World!,@2023", result);
    }
    @Test
    @Tag("valid")
    public void joinListWithMixedDataTypes() {
        LinkedList mixedDataTypesList = mock(LinkedList.class);
        Node node1 = new Node("Hello");
        Node node2 = new Node("123"); // Assuming conversion to String
        Node node3 = new Node("true"); // Assuming conversion to String
        node1.next = node2;
        node2.next = node3;
        when(mixedDataTypesList.head).thenReturn(node1);
        String result = StringUtils.join(mixedDataTypesList);
        assertEquals("Hello,123,true", result);
    }
}