package org.example.utilities;
import org.example.list.LinkedList;
import org.example.StringUtils;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void joinWithMultipleElements() {
        LinkedList<Object> source = new LinkedList<>();
        source.add("Hello");
        source.add("World");
        source.add("Java");
        String result = StringUtils.join(source);
        assertEquals("Hello,World,Java", result);
    }
    @Test
    @Tag("boundary")
    public void joinWithSingleElement() {
        LinkedList<Object> source = new LinkedList<>();
        source.add("Test");
        String result = StringUtils.join(source);
        assertEquals("Test", result);
    }
    @Test
    @Tag("boundary")
    public void joinWithEmptyList() {
        LinkedList<Object> source = new LinkedList<>();
        String result = StringUtils.join(source);
        assertEquals("", result);
    }
    @Test
    @Tag("valid")
    public void joinWithNullElementsInList() {
        LinkedList<Object> source = new LinkedList<>();
        source.add("first");
        source.add(null);
        source.add("last");
        String result = StringUtils.join(source);
        assertEquals("first,null,last", result);
    }
    @Test
    @Tag("valid")
    public void joinWithEmptyStringsInList() {
        LinkedList<Object> source = new LinkedList<>();
        source.add("apple");
        source.add("");
        source.add("banana");
        String result = StringUtils.join(source);
        assertEquals("apple,,banana", result);
    }
    @Test
    @Tag("invalid")
    public void joinWithNullList() {
        LinkedList<Object> source = null;
        assertThrows(NullPointerException.class, () -> {
            StringUtils.join(source);
        });
    }
    @Test
    @Tag("valid")
    public void joinWithMixedObjectTypes() {
        LinkedList<Object> source = new LinkedList<>();
        source.add("ID");
        source.add(123);
        source.add(true);
        String result = StringUtils.join(source);
        assertEquals("ID,123,true", result);
    }
}