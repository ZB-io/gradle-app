package org.example.utilities;
import org.example.list.LinkedList;
import org.example.StringUtils;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void splitWithMultipleWordsSeparatedBySingleSpaces() {
        String source = "hello world from java";
        LinkedList result = StringUtils.split(source);
        assertEquals(4, result.size());
        assertEquals("hello", result.get(0));
        assertEquals("world", result.get(1));
        assertEquals("from", result.get(2));
        assertEquals("java", result.get(3));
    }
    @Test
    @Tag("boundary")
    public void splitWithEmptyString() {
        String source = "";
        LinkedList result = StringUtils.split(source);
        assertNotNull(result);
        assertEquals(0, result.size());
    }
    @Test
    @Tag("valid")
    public void splitWithSingleWordString() {
        String source = "singleton";
        LinkedList result = StringUtils.split(source);
        assertEquals(1, result.size());
        assertEquals("singleton", result.get(0));
    }
    @Test
    @Tag("boundary")
    public void splitWithLeadingAndTrailingSpaces() {
        String source = "  some words  ";
        LinkedList result = StringUtils.split(source);
        assertEquals(2, result.size());
        assertEquals("some", result.get(0));
        assertEquals("words", result.get(1));
    }
    @Test
    @Tag("valid")
    public void splitWithMultipleSpacesBetweenWords() {
        String source = "words  with   extra   spacing";
        LinkedList result = StringUtils.split(source);
        assertEquals(4, result.size());
        assertEquals("words", result.get(0));
        assertEquals("with", result.get(1));
        assertEquals("extra", result.get(2));
        assertEquals("spacing", result.get(3));
    }
    @Test
    @Tag("boundary")
    public void splitWithWhitespaceOnlyString() {
        String source = "   ";
        LinkedList result = StringUtils.split(source);
        assertNotNull(result);
        assertEquals(0, result.size());
    }
    @Test
    @Tag("valid")
    public void splitWithMixedWhitespaceCharacters() {
        String source = "first\tsecond\nthird fourth";
        LinkedList result = StringUtils.split(source);
        assertEquals(4, result.size());
        assertEquals("first", result.get(0));
        assertEquals("second", result.get(1));
        assertEquals("third", result.get(2));
        assertEquals("fourth", result.get(3));
    }
    @Test
    @Tag("invalid")
    public void splitWithNullInput() {
        assertThrows(NullPointerException.class, () -> {
            StringUtils.split(null);
        });
    }
}