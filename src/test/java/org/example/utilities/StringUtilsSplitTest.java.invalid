package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void splitStringWithDelimiters() {
        // Arrange
        String input = "one,two,three";
        LinkedList expected = new LinkedList();
        expected.add("one");
        expected.add("two");
        expected.add("three");
        // Act
        LinkedList result = StringUtils.split(input);
        // Assert
        assertEquals(expected.size(), (int) result.size());
        for (int i = 0; i < (int) expected.size(); i++) {
            assertEquals((String) expected.get(i), (String) result.get(i));
        }
    }
