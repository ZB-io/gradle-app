package org.example.utilities;import org.example.StringUtils;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import org.junit.jupiter.api.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void testSplitStringWithSpaceDelimiter() {
        // Arrange
        String source = "hello world test";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(3, result.size());
        assertEquals("hello", (String) result.get(0));
        assertEquals("world", (String) result.get(1));
        assertEquals("test", (String) result.get(2));
    }
    @Test
    @Tag("boundary")
    public void testSplitNullString() {
        // Arrange
        String source = null;
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(0, result.size());
    }
    @Test
    @Tag("boundary")
    public void testSplitEmptyString() {
        // Arrange
        String source = "";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(0, result.size());
    }
    @Test
    @Tag("valid")
    public void testSplitStringWithNoDelimiters() {
        // Arrange
        String source = "singleword";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(1, result.size());
        assertEquals("singleword", (String) result.get(0));
    }
    @Test
    @Tag("valid")
    public void testSplitStringWithMultipleSpacesBetweenWords() {
        // Arrange
        String source = "hello   world";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(2, result.size());
        assertEquals("hello", (String) result.get(0));
        assertEquals("world", (String) result.get(1));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringWithLeadingAndTrailingSpaces() {
        // Arrange
        String source = "  hello world  ";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(2, result.size());
        assertEquals("hello", (String) result.get(0));
        assertEquals("world", (String) result.get(1));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringContainingOnlyWhitespace() {
        // Arrange
        String source = "   ";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(0, result.size());
    }
    @Test
    @Tag("boundary")
    public void testSplitStringStartingAndEndingWithDelimiter() {
        // Arrange
        String source = " hello world ";
        // Act
        LinkedList result = StringUtils.split(source);
        // Assert
        assertNotNull(result);
        assertEquals(2, result.size());
        assertEquals("hello", (String) result.get(0));
        assertEquals("world", (String) result.get(1));
    }
}