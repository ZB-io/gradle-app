package org.example.utilities;import org.example.list.LinkedList;
import org.example.utilities.StringUtils;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void splitSimpleCommaSeparatedString() {
        String input = "apple,banana,orange";
        LinkedList expected = new LinkedList();
        expected.add("apple");
        expected.add("banana");
        expected.add("orange");
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should correctly split a simple comma-separated string.");
    }
    @Test
    @Tag("boundary")
    public void splitEmptyString() {
        String input = "";
        LinkedList expected = new LinkedList();
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should return an empty LinkedList for an empty input string.");
    }
    @Test
    @Tag("valid")
    public void splitStringWithNoDelimiters() {
        String input = "apple";
        LinkedList expected = new LinkedList();
        expected.add("apple");
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should return the original string as a single element when no delimiters are present.");
    }
    @Test
    @Tag("valid")
    public void splitStringWithConsecutiveDelimiters() {
        String input = "apple,,orange";
        LinkedList expected = new LinkedList();
        expected.add("apple");
        expected.add("");
        expected.add("orange");
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should correctly identify empty elements between consecutive delimiters.");
    }
    @Test
    @Tag("boundary")
    public void splitStringWithLeadingAndTrailingDelimiters() {
        String input = ",apple,orange,";
        LinkedList expected = new LinkedList();
        expected.add("");
        expected.add("apple");
        expected.add("orange");
        expected.add("");
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should correctly identify empty elements at the start and end of the string.");
    }
    @Test
    @Tag("integration")
    public void splitStringWithDifferentDelimiters() {
        // Comment: The business logic needs to handle multiple delimiters like ';' and ','.
        // Suggestion: Update the split method to handle multiple delimiters.
        String input = "apple;banana,orange";
        LinkedList expected = new LinkedList();
        expected.add("apple");
        expected.add("banana");
        expected.add("orange");
        LinkedList result = StringUtils.split(input);
        assertEquals(expected, result, "The split method should correctly split the string based on different delimiters.");
    }
}