package org.example.utilities;
import org.example.StringUtils;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void splitWithStandardSpaceDelimitedString() {
        // Arrange
        String source = "hello world java";
        LinkedList expected = new LinkedList();
        expected.add("hello");
        expected.add("world");
        expected.add("java");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void splitWithEmptyString() {
        // Arrange
        String source = "";
        LinkedList expected = new LinkedList();
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void splitWithSingleWordString() {
        // Arrange
        String source = "singleton";
        LinkedList expected = new LinkedList();
        expected.add("singleton");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void splitWithMultipleSpacesBetweenWords() {
        // Arrange
        String source = "multiple  spaces   here";
        LinkedList expected = new LinkedList();
        expected.add("multiple");
        expected.add("spaces");
        expected.add("here");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void splitWithLeadingAndTrailingWhitespace() {
        // Arrange
        String source = "  padded string  ";
        LinkedList expected = new LinkedList();
        expected.add("padded");
        expected.add("string");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("valid")
    public void splitWithMixedWhitespaceCharacters() {
        // Arrange
        String source = "first\tsecond\nthird fourth";
        LinkedList expected = new LinkedList();
        expected.add("first");
        expected.add("second");
        expected.add("third");
        expected.add("fourth");
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("boundary")
    public void splitWithWhitespaceOnlyString() {
        // Arrange
        String source = " \t \n ";
        LinkedList expected = new LinkedList();
        // Act
        LinkedList actual = StringUtils.split(source);
        // Assert
        assertEquals(expected, actual);
    }
    @Test
    @Tag("invalid")
    public void splitWithNullInput() {
        // Arrange
        String source = null;
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            StringUtils.split(source);
        });
    }
}