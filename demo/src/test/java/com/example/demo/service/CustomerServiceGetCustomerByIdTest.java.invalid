package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;

@ExtendWith(MockitoExtension.class)
class CustomerServiceGetCustomerByIdTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    // Assuming Customer class has a constructor like Customer(Long id, String name, String email)
    // and properly implemented equals/hashCode for object comparison.
    // If not, adjust Customer instantiation and assertions to compare fields individually.
    @Test
    @Tag("valid")
    public void getCustomerByIdReturnsCustomerWhenFound() {
        // Arrange
        Long customerId = 1L;
        // Fix: Instantiate Customer using no-argument constructor and setters
        Customer expectedCustomer = new Customer();
        expectedCustomer.setId(customerId);
        expectedCustomer.setName("Alice");
        expectedCustomer.setEmail("alice@example.com");
        when(customerRepository.findById(customerId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> actualCustomerOptional = customerService.getCustomerById(customerId);
        // Assert
        assertTrue(actualCustomerOptional.isPresent(), "Optional should contain a customer.");
        assertEquals(expectedCustomer, actualCustomerOptional.get(), "The retrieved customer should match the expected customer.");
        verify(customerRepository, times(1)).findById(customerId);
    }
    @Test
    @Tag("invalid")
    public void getCustomerByIdReturnsEmptyOptionalWhenNotFound() {
        // Arrange
        Long nonExistentId = 99L;
        when(customerRepository.findById(nonExistentId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actualCustomerOptional = customerService.getCustomerById(nonExistentId);
        // Assert
        assertTrue(actualCustomerOptional.isEmpty(), "Optional should be empty when customer is not found.");
        verify(customerRepository, times(1)).findById(nonExistentId);
    }
    @Test
    @Tag("invalid")
    public void getCustomerByIdThrowsIllegalArgumentExceptionForNullId() {
        // Arrange
        // Mocking findById(null) to throw IllegalArgumentException as per scenario description.
        // Spring Data JPA's SimpleJpaRepository.findById(ID id) typically throws IllegalArgumentException for null ID.
        when(customerRepository.findById(null)).thenThrow(IllegalArgumentException.class);
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            customerService.getCustomerById(null);
        }, "Calling getCustomerById with a null ID should throw IllegalArgumentException.");
        // TODO: If a specific exception message is expected, uncomment and update the assertion below.
        // IllegalArgumentException thrown = assertThrows(IllegalArgumentException.class, () -> customerService.getCustomerById(null));
        // assertEquals("ID must not be null!", thrown.getMessage());
        verify(customerRepository, times(1)).findById(null);
    }
    @Test
    @Tag("boundary")
    public void getCustomerByIdReturnsEmptyOptionalForNegativeId() {
        // Arrange
        Long negativeId = -1L;
        when(customerRepository.findById(negativeId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> actualCustomerOptional = customerService.getCustomerById(negativeId);
        // Assert
        assertTrue(actualCustomerOptional.isEmpty(), "Optional should be empty for a negative ID.");
        verify(customerRepository, times(1)).findById(negativeId);
    }
}