package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    @InjectMocks
    private CustomerService customerService;
    // No @BeforeEach needed as @InjectMocks handles instantiation and injection for each test.
    @Test
    @Tag("valid")
    public void getAllCustomersReturnsMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer();
        // TODO: Set appropriate properties for customer1, e.g., customer1.setId(1L); customer1.setName("John Doe");
        Customer customer2 = new Customer();
        // TODO: Set appropriate properties for customer2, e.g., customer2.setId(2L); customer2.setName("Jane Smith");
        List<Customer> customers = Arrays.asList(customer1, customer2);
        when(customerRepository.findAll()).thenReturn(customers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list of customers should not be null.");
        assertEquals(2, actualCustomers.size(), "The returned list should contain 2 customers.");
        assertTrue(actualCustomers.contains(customer1), "The returned list should contain customer1.");
        assertTrue(actualCustomers.contains(customer2), "The returned list should contain customer2.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("boundary")
    public void getAllCustomersReturnsSingleCustomer() {
        // Arrange
        Customer customer1 = new Customer();
        // TODO: Set appropriate properties for customer1, e.g., customer1.setId(1L); customer1.setName("John Doe");
        List<Customer> customers = Collections.singletonList(customer1);
        when(customerRepository.findAll()).thenReturn(customers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list of customers should not be null.");
        assertEquals(1, actualCustomers.size(), "The returned list should contain 1 customer.");
        assertTrue(actualCustomers.contains(customer1), "The returned list should contain customer1.");
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("boundary")
    public void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        List<Customer> customers = Collections.emptyList();
        when(customerRepository.findAll()).thenReturn(customers);
        // Act
        List<Customer> actualCustomers = customerService.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list of customers should not be null.");
        assertTrue(actualCustomers.isEmpty(), "The returned list should be empty.");
        verify(customerRepository, times(1)).findAll();
    }
}