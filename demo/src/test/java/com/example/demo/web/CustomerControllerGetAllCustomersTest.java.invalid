package com.example.demo.web;
import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetAllCustomersTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        // The @InjectMocks and @Mock annotations handle the injection,
        // but if CustomerController had other dependencies not mocked,
        // or if we weren't using @InjectMocks, we would manually instantiate:
        // customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void retrieveMultipleCustomersSuccessfully() {
        // Arrange
        Customer customer1 = new Customer();
        // TODO: Set a valid ID for customer1 if Customer has an ID field and it's relevant for comparison
        // customer1.setId(1L); 
        customer1.setName("Alice");
        customer1.setEmail("alice@example.com");
        Customer customer2 = new Customer();
        // TODO: Set a valid ID for customer2 if Customer has an ID field and it's relevant for comparison
        // customer2.setId(2L);
        customer2.setName("Bob");
        customer2.setEmail("bob@example.com");
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2);
        when(customerService.getAllCustomers()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list of customers should not be null.");
        assertEquals(2, actualCustomers.size(), "The returned list should contain exactly two customers.");
        assertTrue(actualCustomers.contains(customer1), "The returned list should contain customer1.");
        assertTrue(actualCustomers.contains(customer2), "The returned list should contain customer2.");
        // Verify that the service method was called exactly once
        verify(customerService, times(1)).getAllCustomers();
    }
    @Test
    @Tag("boundary")
    public void retrieveNoCustomers() {
        // Arrange
        when(customerService.getAllCustomers()).thenReturn(Collections.emptyList());
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers, "The returned list of customers should not be null.");
        assertTrue(actualCustomers.isEmpty(), "The returned list should be empty.");
        assertEquals(0, actualCustomers.size(), "The returned list should have a size of 0.");
        // Verify that the service method was called exactly once
        verify(customerService, times(1)).getAllCustomers();
    }
    @Test
    @Tag("invalid")
    public void handleServiceRuntimeException() {
        // Arrange
        String errorMessage = "Database connection failed";
        when(customerService.getAllCustomers()).thenThrow(new IllegalStateException(errorMessage));
        // Act & Assert
        IllegalStateException thrownException = assertThrows(IllegalStateException.class, () -> {
            customerController.getAllCustomers();
        }, "Expected IllegalStateException to be thrown when service fails.");
        assertEquals(errorMessage, thrownException.getMessage(), "The exception message should match the expected message.");
        // Verify that the service method was called exactly once
        verify(customerService, times(1)).getAllCustomers();
    }
}