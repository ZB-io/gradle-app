package com.example.demo.web;
import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@ExtendWith(MockitoExtension.class)
public class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    public void getCustomerByIdReturnsExistingCustomer() {
        // Arrange
        Long customerId = 1L;
        Customer customer = new Customer("John Doe", "john.doe@example.com"); // TODO: Set appropriate customer details
        when(customerService.getCustomerById(customerId)).thenReturn(Optional.of(customer));
        // Act
        Optional<Customer> result = customerController.getCustomerById(customerId);
        // Assert
        assertTrue(result.isPresent(), "The returned Optional should be present for an existing customer.");
        assertEquals(customer, result.get(), "The returned customer should match the expected customer.");
        verify(customerService, times(1)).getCustomerById(customerId);
    }
    @Test
    @Tag("invalid")
    public void getCustomerByIdReturnsEmptyOptionalForNonExistentCustomer() {
        // Arrange
        Long nonExistentCustomerId = 99L;
        when(customerService.getCustomerById(nonExistentCustomerId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(nonExistentCustomerId);
        // Assert
        assertFalse(result.isPresent(), "The returned Optional should be empty for a non-existent customer.");
        assertEquals(Optional.empty(), result, "The returned Optional should be empty.");
        verify(customerService, times(1)).getCustomerById(nonExistentCustomerId);
    }
    @Test
    @Tag("invalid")
    public void getCustomerByIdPropagatesServiceException() {
        // Arrange
        Long customerId = 1L;
        RuntimeException expectedException = new RuntimeException("Database connection lost");
        when(customerService.getCustomerById(customerId)).thenThrow(expectedException);
        // Act & Assert
        RuntimeException thrown = assertThrows(RuntimeException.class, () -> {
            customerController.getCustomerById(customerId);
        }, "Expected RuntimeException to be thrown by getCustomerById.");
        assertEquals(expectedException.getMessage(), thrown.getMessage(), "The exception message should match the expected message.");
        verify(customerService, times(1)).getCustomerById(customerId);
    }
}