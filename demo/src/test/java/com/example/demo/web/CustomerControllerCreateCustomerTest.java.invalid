package com.example.demo.web;import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class CustomerControllerCreateCustomerTest {
    @Mock
    private CustomerService customerService;
    @InjectMocks
    private CustomerController customerController;
    // Assuming Customer class has constructors like:
    // public Customer(String name, String email)
    // public Customer(Long id, String name, String email)
    // If not, adjust Customer object creation to use available constructors or setters.
    @Test
    @Tag("valid")
    public void createCustomerSuccessfully() {
        // Arrange
        Customer inputCustomer = new Customer("Alice", "alice@example.com");
        Customer createdCustomer = new Customer("Alice", "alice@example.com"); // Use constructor for name and email
        createdCustomer.setId(1L); // Set the ID using a setter as the constructor with ID is not available
        when(customerService.createCustomer(inputCustomer)).thenReturn(createdCustomer);
        // Act
        Customer actualCustomer = customerController.createCustomer(inputCustomer);
        // Assert
        assertNotNull(actualCustomer, "The returned customer should not be null.");
        assertEquals(createdCustomer.getId(), actualCustomer.getId(), "The ID of the created customer should match.");
        assertEquals(createdCustomer.getName(), actualCustomer.getName(), "The name of the created customer should match.");
        assertEquals(createdCustomer.getEmail(), actualCustomer.getEmail(), "The email of the created customer should match.");
        verify(customerService, times(1)).createCustomer(inputCustomer);
        verifyNoMoreInteractions(customerService);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWhenServiceThrowsException() {
        // Arrange
        Customer invalidCustomer = new Customer("Bob", "bob@example.com");
        RuntimeException expectedException = new RuntimeException("Duplicate email found");
        when(customerService.createCustomer(invalidCustomer)).thenThrow(expectedException);
        // Act & Assert
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            customerController.createCustomer(invalidCustomer);
        }, "Expected RuntimeException to be thrown.");
        assertEquals(expectedException.getMessage(), thrownException.getMessage(), "The exception message should match.");
        verify(customerService, times(1)).createCustomer(invalidCustomer);
        verifyNoMoreInteractions(customerService);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithNullRequestBody() {
        // Arrange
        // In a unit test of the controller method, passing null directly means the method IS invoked.
        // We simulate the service layer rejecting a null customer object, as the controller itself
        // does not perform null checks on the @RequestBody parameter.
        when(customerService.createCustomer(isNull())).thenThrow(new IllegalArgumentException("Customer object cannot be null"));
        // Act & Assert
        IllegalArgumentException thrownException = assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(null);
        }, "Expected IllegalArgumentException for null customer object.");
        assertEquals("Customer object cannot be null", thrownException.getMessage(), "The exception message should indicate null customer.");
        verify(customerService, times(1)).createCustomer(isNull());
        verifyNoMoreInteractions(customerService);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithNullFields() {
        // Arrange
        Customer customerWithNullName = new Customer(null, "invalid@example.com"); // Customer with null name
        IllegalArgumentException expectedException = new IllegalArgumentException("Customer name cannot be null");
        when(customerService.createCustomer(customerWithNullName)).thenThrow(expectedException);
        // Act & Assert
        IllegalArgumentException thrownException = assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(customerWithNullName);
        }, "Expected IllegalArgumentException for customer with null name.");
        assertEquals(expectedException.getMessage(), thrownException.getMessage(), "The exception message should match.");
        verify(customerService, times(1)).createCustomer(customerWithNullName);
        verifyNoMoreInteractions(customerService);
    }
    @Test
    @Tag("invalid")
    public void createCustomerWithEmptyStringFields() {
        // Arrange
        Customer customerWithEmptyEmail = new Customer("Valid Name", ""); // Customer with empty email
        IllegalArgumentException expectedException = new IllegalArgumentException("Customer email cannot be empty");
        when(customerService.createCustomer(customerWithEmptyEmail)).thenThrow(expectedException);
        // Act & Assert
        IllegalArgumentException thrownException = assertThrows(IllegalArgumentException.class, () -> {
            customerController.createCustomer(customerWithEmptyEmail);
        }, "Expected IllegalArgumentException for customer with empty email.");
        assertEquals(expectedException.getMessage(), thrownException.getMessage(), "The exception message should match.");
        verify(customerService, times(1)).createCustomer(customerWithEmptyEmail);
        verifyNoMoreInteractions(customerService);
    }
}