// In a real project, the Customer class CustomerGetNameTest typically be in its own file: src/main/java/com/example/demo/domain/Customer.java
 class CustomerGetNameTest {
    @Test
    @Tag("valid")
    public void retrieveStandardCustomerName() {
        // Arrange
        Customer customer = new Customer("Alice", "alice@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertThat(actualName).isEqualTo("Alice");
    }
    @Test
    @Tag("boundary")
    public void retrieveCustomerNameWhenNull() {
        // Arrange
        Customer customer = new Customer();
        customer.setName(null);
        // Act
        String actualName = customer.getName();
        // Assert
        assertThat(actualName).isNull();
    }
    @Test
    @Tag("boundary")
    public void retrieveCustomerNameWhenEmpty() {
        // Arrange
        Customer customer = new Customer("", "empty@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertThat(actualName).isEqualTo("");
    }
    @Test
    @Tag("boundary")
    public void retrieveCustomerNameWithWhitespaceOnly() {
        // Arrange
        Customer customer = new Customer("   ", "whitespace@example.com");
        // Act
        String actualName = customer.getName();
        // Assert
        assertThat(actualName).isEqualTo("   ");
    }
    @Test
    @Tag("valid")
    public void retrieveUpdatedCustomerName() {
        // Arrange
        Customer customer = new Customer("Old Name", "old@example.com");
        customer.setName("New Name");
        // Act
        String actualName = customer.getName();
        // Assert
        assertThat(actualName).isEqualTo("New Name");
    }
}